-- database: ./database.db

SELECT
    f.food_name,
    i.ingredients_name,
    p.preparation_method_name,
    fip.prep_step_order
FROM food f
JOIN food_ingredients fi
    ON f.food_id = fi.food_id
JOIN ingredients i
    ON fi.ingredients_id = i.ingredients_id
JOIN food_ingredient_preparation fip
    ON fi.food_ingredients_id = fip.food_ingredients_id
JOIN preparation_method p
    ON fip.preparation_method_id = p.preparation_method_id
WHERE f.food_name = 'Fried rice' -- Change these two statements
ORDER BY i.ingredients_name;
