-- FISH
INSERT INTO RFIDTags (tag_rfid, ingredients_id, current_status)
SELECT v.tag_rfid, (SELECT ingredients_id FROM ingredients WHERE ingredients_name = 'Fish'), 'Default'
FROM (
    SELECT '67;7F;E9;03' AS tag_rfid
