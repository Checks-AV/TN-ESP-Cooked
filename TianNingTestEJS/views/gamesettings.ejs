<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket Rail — Control Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Courier+Prime:wght@400;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* =========================================================
       DESIGN TOKENS - Refined
       ========================================================= */
    :root {
      /* surfaces */
      --bg-primary: #0f1113;
      --bg-secondary: #181a1d;
      --bg-card: rgba(255, 255, 255, 0.03);
      --bg-card-hover: rgba(255, 255, 255, 0.06);
      --bg-well: rgba(0, 0, 0, 0.4);
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border-medium: rgba(255, 255, 255, 0.1);

      /* ink */
      --ink: #e8e4dc;
      --ink-bright: #f5f2ea;
      --ink-dim: #a89f8f;
      --ink-faint: #6b6558;

      /* accents */
      --green: #4a9d6e;
      --green-bg: rgba(74, 157, 110, 0.15);
      --green-glow: rgba(74, 157, 110, 0.3);
      
      --amber: #dfa62e;
      --amber-bg: rgba(223, 166, 46, 0.15);
      
      --red: #d9463c;
      --red-bg: rgba(217, 70, 60, 0.15);
      --red-glow: rgba(217, 70, 60, 0.3);
      
      --blue: #6cb4ee;
      --violet: #c96ad6;
      --teal: #4ad6d6;

      /* ticket */
      --ticket-bg: #f3ecd8;
      --ticket-ink: #26241f;

      /* type */
      --font-display: 'Bebas Neue', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-mono: 'Courier Prime', monospace;

      /* spacing */
      --space-1: 4px;
      --space-2: 8px;
      --space-3: 12px;
      --space-4: 16px;
      --space-5: 24px;
      --space-6: 32px;
      --space-7: 48px;

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --radius-xl: 20px;
      --radius-pill: 999px;
    }

    * { box-sizing: border-box; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg-primary);
      font-family: var(--font-body);
      color: var(--ink);
      padding: var(--space-5);
      background-image: 
        radial-gradient(ellipse at 20% 50%, rgba(74, 157, 110, 0.03) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 50%, rgba(217, 70, 60, 0.03) 0%, transparent 60%);
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg-secondary); }
    ::-webkit-scrollbar-thumb { background: #3a3f44; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #4a5054; }

    /* =========================================================
       HEADER
       ========================================================= */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5);
      background: var(--bg-secondary);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      margin-bottom: var(--space-5);
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
    }
    .brand h1 {
      font-family: var(--font-display);
      font-size: 32px;
      letter-spacing: 2px;
      margin: 0;
      background: linear-gradient(135deg, var(--ink-bright) 0%, var(--ink-dim) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .brand .sub {
      font-size: 11px;
      letter-spacing: 2px;
      color: var(--ink-faint);
      text-transform: uppercase;
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .status-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      font-size: 12px;
      font-weight: 600;
      background: var(--bg-well);
      border: 1px solid var(--border-subtle);
    }
    .status-badge .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }
    .status-badge .dot.online { background: var(--green); box-shadow: 0 0 8px var(--green-glow); }
    .status-badge .dot.offline { background: var(--red); }
    .status-badge .dot.idle { background: var(--ink-faint); }

    /* =========================================================
       LAYOUT
       ========================================================= */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
      margin-bottom: var(--space-5);
    }
    @media (max-width: 1200px) {
      .dashboard-grid { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      transition: border-color 0.2s, background 0.2s;
    }
    .card:hover {
      border-color: var(--border-medium);
      background: var(--bg-card-hover);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--border-subtle);
    }
    .card-header h2 {
      font-family: var(--font-display);
      font-size: 20px;
      letter-spacing: 0.5px;
      margin: 0;
      color: var(--ink-bright);
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    .card-header .badge {
      font-family: var(--font-body);
      font-size: 10px;
      font-weight: 700;
      padding: 3px 12px;
      border-radius: var(--radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-green { background: var(--green-bg); color: var(--green); }
    .badge-red { background: var(--red-bg); color: var(--red); }
    .badge-amber { background: var(--amber-bg); color: var(--amber); }
    .badge-dim { background: rgba(255,255,255,0.05); color: var(--ink-faint); }

    /* =========================================================
       CONTROLS
       ========================================================= */
    .control-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-4);
      align-items: center;
    }
    .control-group + .control-group {
      margin-top: var(--space-4);
    }

    .control-item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex: 1;
      min-width: 160px;
    }
    .control-item label {
      font-size: 12px;
      font-weight: 600;
      color: var(--ink-dim);
      min-width: 80px;
      letter-spacing: 0.3px;
    }
    .control-item input[type="range"] {
      flex: 1;
      min-width: 80px;
      height: 4px;
      border-radius: 2px;
      background: var(--bg-well);
      -webkit-appearance: none;
      appearance: none;
      outline: none;
    }
    .control-item input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--ink-bright);
      cursor: pointer;
      border: 2px solid var(--bg-primary);
      transition: transform 0.15s;
    }
    .control-item input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }
    .control-item input[type="range"]::-moz-range-thumb {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--ink-bright);
      cursor: pointer;
      border: 2px solid var(--bg-primary);
    }

    .control-item input[type="range"].accent-green::-webkit-slider-thumb { background: var(--green); }
    .control-item input[type="range"].accent-red::-webkit-slider-thumb { background: var(--red); }
    .control-item input[type="range"].accent-amber::-webkit-slider-thumb { background: var(--amber); }
    .control-item input[type="range"].accent-violet::-webkit-slider-thumb { background: var(--violet); }

    .value-badge {
      background: var(--bg-well);
      padding: 2px 10px;
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink-dim);
      min-width: 48px;
      text-align: center;
      font-weight: 600;
      border: 1px solid var(--border-subtle);
    }

    /* =========================================================
       PRESETS
       ========================================================= */
    .preset-row {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
      margin-top: var(--space-3);
    }
    .preset-btn {
      background: var(--bg-well);
      border: 1px solid var(--border-subtle);
      color: var(--ink-dim);
      padding: 5px 14px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.3px;
    }
    .preset-btn:hover {
      background: var(--green-bg);
      border-color: var(--green);
      color: var(--green);
      transform: translateY(-1px);
    }

    /* =========================================================
       BUTTONS
       ========================================================= */
    .btn {
      padding: 8px 18px;
      border: none;
      border-radius: var(--radius-pill);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.3px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none !important;
    }
    .btn:not(:disabled):hover {
      transform: translateY(-2px);
    }
    .btn:not(:disabled):active {
      transform: scale(0.97);
    }

    .btn-primary {
      background: var(--green);
      color: #fff;
    }
    .btn-primary:hover:not(:disabled) {
      background: #3d8a5e;
      box-shadow: 0 4px 16px var(--green-glow);
    }

    .btn-secondary {
      background: var(--bg-well);
      color: var(--ink);
      border: 1px solid var(--border-subtle);
    }
    .btn-secondary:hover:not(:disabled) {
      background: var(--border-medium);
    }

    .btn-danger {
      background: var(--red);
      color: #fff;
    }
    .btn-danger:hover:not(:disabled) {
      background: #c23d34;
      box-shadow: 0 4px 16px var(--red-glow);
    }

    .btn-peak {
      background: var(--red);
      color: #fff;
      animation: pulse-peak 2s infinite;
    }
    .btn-peak:hover:not(:disabled) {
      background: #c23d34;
      box-shadow: 0 4px 20px var(--red-glow);
    }
    @keyframes pulse-peak {
      0%, 100% { box-shadow: 0 0 0 0 rgba(217, 70, 60, 0.3); }
      50% { box-shadow: 0 0 20px 8px rgba(217, 70, 60, 0.15); }
    }

    .btn-full {
      width: 100%;
      justify-content: center;
    }

    .btn-row {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
    }

    /* =========================================================
       STATS
       ========================================================= */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    @media (max-width: 600px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .stat-item {
      background: var(--bg-well);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
      text-align: center;
      border: 1px solid var(--border-subtle);
    }
    .stat-item .num {
      font-family: var(--font-display);
      font-size: 28px;
      display: block;
      color: var(--ink-bright);
      letter-spacing: 1px;
    }
    .stat-item .label {
      font-size: 10px;
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
    }
    .stat-item .num.score { color: var(--amber); }
    .stat-item .num.served { color: var(--green); }
    .stat-item .num.missed { color: var(--red); }
    .stat-item .num.failed { color: var(--red); }

    /* =========================================================
       SERVICE CLOCK
       ========================================================= */
    .service-clock {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      margin-top: var(--space-4);
      padding: var(--space-3) var(--space-4);
      background: var(--bg-well);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
    }
    .service-clock .time {
      font-family: var(--font-display);
      font-size: 28px;
      color: var(--ink-bright);
      min-width: 72px;
      letter-spacing: 2px;
    }
    .service-clock .track {
      flex: 1;
      height: 6px;
      background: rgba(255,255,255,0.06);
      border-radius: 3px;
      overflow: hidden;
    }
    .service-clock .track .fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, var(--green), var(--amber) 65%, var(--red));
      transition: width 0.5s ease;
      border-radius: 3px;
    }
    .service-clock .label {
      font-size: 11px;
      color: var(--ink-faint);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* =========================================================
       SWITCH (Peak Toggle)
       ========================================================= */
    .switch-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
      padding: var(--space-3) var(--space-4);
      background: var(--bg-well);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
    }
    .switch-label {
      font-size: 13px;
      font-weight: 600;
    }
    .switch-label .desc {
      display: block;
      font-size: 11px;
      color: var(--ink-faint);
      font-weight: 400;
      margin-top: 2px;
    }
    .switch {
      position: relative;
      display: inline-block;
      width: 48px;
      height: 26px;
      flex-shrink: 0;
    }
    .switch input {
      position: absolute;
      opacity: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      cursor: pointer;
      z-index: 2;
    }
    .slider-toggle {
      position: absolute;
      pointer-events: none;
      inset: 0;
      background: #3d4347;
      transition: background 0.25s;
      border-radius: var(--radius-pill);
    }
    .slider-toggle::before {
      position: absolute;
      content: "";
      height: 20px;
      width: 20px;
      left: 3px;
      bottom: 3px;
      background: var(--ink);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      border-radius: 50%;
    }
    .switch input:checked + .slider-toggle {
      background: var(--red);
    }
    .switch input:checked + .slider-toggle::before {
      transform: translateX(22px);
    }

    /* =========================================================
       PEAK STATUS
       ========================================================= */
    .peak-status {
      margin-top: var(--space-4);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
      font-size: 12px;
      font-family: var(--font-mono);
      display: flex;
      align-items: center;
      gap: var(--space-3);
      border: 1px solid var(--border-subtle);
      background: var(--bg-well);
      transition: all 0.3s;
    }
    .peak-status .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
      transition: all 0.3s;
    }
    .peak-status .dot.idle {
      background: var(--ink-faint);
    }
    .peak-status .dot.active {
      background: var(--red);
      box-shadow: 0 0 16px var(--red-glow);
      animation: pulse-dot 0.8s infinite;
    }
    .peak-status .dot.manual {
      background: #ff6b4a;
      box-shadow: 0 0 20px rgba(255, 107, 74, 0.5);
      animation: pulse-dot 0.4s infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }
    .peak-status.active {
      border-color: var(--red);
      background: var(--red-bg);
    }
    .peak-status.manual {
      border-color: #ff6b4a;
      background: rgba(255, 107, 74, 0.1);
    }

    /* =========================================================
       MINI RAIL
       ========================================================= */
    .mini-rail {
      display: flex;
      gap: var(--space-3);
      padding: var(--space-3) 0;
      overflow-x: auto;
      min-height: 56px;
      align-items: center;
      flex-wrap: nowrap;
    }
    .mini-rail::-webkit-scrollbar { height: 4px; }
    .mini-rail::-webkit-scrollbar-thumb { background: #4a5054; border-radius: 2px; }

    .mini-ticket {
      background: var(--ticket-bg);
      color: var(--ticket-ink);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 11px;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      transform: rotate(var(--tilt, 0deg));
      flex: 0 0 auto;
      animation: miniDrop 0.3s ease-out;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    @keyframes miniDrop {
      from { transform: translateY(-10px) rotate(var(--tilt, 0deg)); opacity: 0; }
      to { transform: translateY(0) rotate(var(--tilt, 0deg)); opacity: 1; }
    }
    .mini-ticket .dish { font-weight: 700; font-size: 12px; }
    .mini-ticket .time { color: var(--ticket-faint); font-size: 10px; }
    .mini-ticket .status {
      font-size: 8px;
      padding: 1px 8px;
      border-radius: var(--radius-pill);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .status.waiting { background: var(--amber); color: var(--amber-ink); }
    .status.completed { background: var(--green); color: #fff; }
    .status.missed, .status.failed { background: var(--red); color: #fff; }
    .status.cooking { background: #d4cbaa; color: #5a5334; }
    .status.validating { background: var(--teal); color: #fff; }

    .empty-rail {
      color: var(--ink-faint);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: var(--space-3) 0;
    }

    .order-count {
      background: var(--green);
      color: #fff;
      padding: 2px 10px;
      border-radius: var(--radius-pill);
      font-size: 12px;
      font-weight: 700;
    }

    /* =========================================================
       LOGS
       ========================================================= */
    .logs-container {
      max-height: 280px;
      overflow-y: auto;
      background: var(--bg-well);
      border-radius: var(--radius-md);
      padding: var(--space-3);
      font-family: var(--font-mono);
      font-size: 11px;
      border: 1px solid var(--border-subtle);
    }
    .log-entry {
      padding: 4px 0;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      gap: var(--space-3);
      align-items: baseline;
    }
    .log-time {
      color: var(--ink-faint);
      font-size: 10px;
      min-width: 70px;
      flex-shrink: 0;
    }
    .log-type {
      font-size: 9px;
      padding: 1px 8px;
      border-radius: var(--radius-pill);
      font-weight: 700;
      min-width: 60px;
      text-align: center;
      flex-shrink: 0;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .log-type.info { background: #1a2a4a; color: var(--blue); }
    .log-type.success { background: #1a4a2a; color: var(--green); }
    .log-type.error { background: #4a1a1a; color: var(--red); }
    .log-type.esp { background: #4a3a1a; color: var(--amber); }
    .log-type.submit { background: #3a1a4a; color: var(--violet); }
    .log-type.order { background: #1a2a4a; color: var(--blue); }
    .log-type.peak { background: #4a1a1a; color: #ff8a70; }
    .log-type.db { background: #1a4a1a; color: var(--green); }
    .log-type.match { background: #1a3a3a; color: var(--teal); }
    .log-message { color: var(--ink); word-break: break-word; }

    .logs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-3);
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .logs-actions {
      display: flex;
      gap: var(--space-2);
    }

    /* =========================================================
       ESP Status
       ========================================================= */
    .esp-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-subtle);
    }
    .esp-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 14px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 600;
    }
    .esp-status.online { background: var(--green-bg); color: var(--green); }
    .esp-status.offline { background: var(--red-bg); color: var(--red); }
    .esp-status.waiting { background: var(--amber-bg); color: var(--amber); }

    /* =========================================================
       RESPONSIVE
       ========================================================= */
    @media (max-width: 768px) {
      body { padding: var(--space-4); }
      .header { flex-direction: column; align-items: stretch; }
      .brand h1 { font-size: 24px; }
      .header-actions { justify-content: flex-start; }
      .card { padding: var(--space-4); }
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
      .control-item { min-width: 140px; }
      .service-clock .time { font-size: 22px; min-width: 56px; }
    }

    @media (max-width: 480px) {
      .control-item { min-width: 100%; }
      .btn-row .btn { flex: 1; justify-content: center; }
      .stat-grid { grid-template-columns: 1fr 1fr; gap: var(--space-2); }
      .stat-item .num { font-size: 22px; }
    }
  </style>
</head>
<body>

<header class="header">
  <div class="brand">
    <h1>Ticket Rail</h1>
    <span class="sub">Control Dashboard</span>
  </div>
  <div class="header-actions">
    <a href="/game" class="btn btn-secondary">🎮 Game View</a>
    <span class="status-badge">
      <span class="dot online" id="headerDot"></span>
      <span id="headerStatus">Connected</span>
    </span>
    <span class="status-badge">
      <span class="dot idle" id="liveDot"></span>
      <span id="liveLabel">idle</span>
    </span>
  </div>
</header>

<div class="dashboard-grid">
  <!-- LEFT COLUMN: Timing & Frequency -->
  <div class="card">
    <div class="card-header">
      <h2>⏱ Timing & Frequency</h2>
    </div>

    <div class="control-group">
      <div class="control-item">
        <label>Min Spawn</label>
        <input type="range" id="spawnMin" min="1" max="60" value="6" step="0.5" class="accent-green">
        <span class="value-badge" id="spawnMinVal">6s</span>
      </div>
      <div class="control-item">
        <label>Max Spawn</label>
        <input type="range" id="spawnMax" min="2" max="120" value="11" step="0.5" class="accent-green">
        <span class="value-badge" id="spawnMaxVal">11s</span>
      </div>
    </div>

    <div class="control-group">
      <div class="control-item">
        <label>Prep Time</label>
        <input type="range" id="prepTime" min="5" max="300" value="22" step="1" class="accent-amber">
        <span class="value-badge" id="prepTimeVal">22s</span>
      </div>
      <div class="control-item">
        <label>Ramp</label>
        <input type="range" id="rampFactor" min="0.5" max="1.0" value="0.92" step="0.02" class="accent-amber">
        <span class="value-badge" id="rampFactorVal">0.92</span>
      </div>
    </div>

    <div class="control-group">
      <div class="control-item">
        <label>Service Time</label>
        <input type="range" id="totalTime" min="60" max="3600" value="300" step="30" class="accent-violet">
        <span class="value-badge" id="totalTimeVal">5:00</span>
      </div>
    </div>

    <button class="btn btn-primary btn-full" id="sendParamsBtn" style="margin-top: var(--space-4);">
      📤 Apply Settings
    </button>
  </div>

  <!-- RIGHT COLUMN: Service Controls -->
  <div class="card">
    <div class="card-header">
      <h2>🎛 Service Controls</h2>
    </div>

    <div class="btn-row">
      <button class="btn btn-primary" id="startBtn">▶ Start</button>
      <button class="btn btn-secondary" id="pauseBtn" disabled>⏸ Pause</button>
      <button class="btn btn-secondary" id="resetBtn">⟳ Reset</button>
      <button class="btn btn-secondary" id="instantOrderBtn">⚡ Add Order</button>
    </div>

    <div class="stat-grid">
      <div class="stat-item">
        <span class="num score" id="statScore">0</span>
        <span class="label">Score</span>
      </div>
      <div class="stat-item">
        <span class="num served" id="statServed">0</span>
        <span class="label">Served</span>
      </div>
      <div class="stat-item">
        <span class="num missed" id="statMissed">0</span>
        <span class="label">Missed</span>
      </div>
      <div class="stat-item">
        <span class="num failed" id="statFailed">0</span>
        <span class="label">Failed</span>
      </div>
    </div>

    <div class="service-clock">
      <span class="label">⏱ Service</span>
      <span class="time" id="serviceTime">05:00</span>
      <div class="track">
        <div class="fill" id="serviceFill"></div>
      </div>
    </div>

    <div class="esp-row">
      <span style="font-size: 12px; color: var(--ink-dim); font-weight: 600;">ESP:</span>
      <span class="esp-status waiting" id="espStatus">⏳ Waiting</span>
      <button class="btn btn-secondary" id="refreshEspBtn" style="padding: 4px 12px; font-size: 11px;">🔄 Refresh</button>
    </div>
  </div>
</div>

<!-- CONCURRENCY & CHAOS -->
<div class="card" style="margin-bottom: var(--space-5);">
  <div class="card-header">
    <h2>🎲 Concurrency &amp; Chaos</h2>
    <span class="badge badge-green" id="chaosBadge">CALM</span>
  </div>

  <div class="control-group">
    <div class="control-item">
      <label>Min on Rail</label>
      <input type="range" id="concurrencyMin" min="0" max="8" value="2" step="1" class="accent-green">
      <span class="value-badge" id="concurrencyMinVal">2</span>
    </div>
    <div class="control-item">
      <label>Max on Rail</label>
      <input type="range" id="concurrencyMax" min="1" max="12" value="5" step="1" class="accent-red">
      <span class="value-badge" id="concurrencyMaxVal">5</span>
    </div>
  </div>

  <div class="control-group">
    <div class="control-item">
      <label>Min Orders Always</label>
      <input type="range" id="minOrdersAlways" min="0" max="8" value="1" step="1" class="accent-amber">
      <span class="value-badge" id="minOrdersAlwaysVal">1</span>
    </div>
    <div class="control-item">
      <label>Chaos</label>
      <input type="range" id="chaosSlider" min="0" max="1" value="0.3" step="0.05" class="accent-violet">
      <span class="value-badge" id="chaosVal">0.30</span>
    </div>
  </div>
</div>

<!-- PEAK HOURS -->
<div class="card" style="margin-bottom: var(--space-5);">
  <div class="card-header">
    <h2>🔥 Peak Hours</h2>
    <span class="badge badge-dim" id="peakBadge">OFF</span>
  </div>

  <div class="switch-row">
    <div class="switch-label">
      Enable Peak Hours
      <span class="desc">Random bursts of high-frequency orders during service</span>
    </div>
    <label class="switch">
      <input type="checkbox" id="peakEnabled">
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div id="peakControls">
    <div class="control-group">
      <div class="control-item">
        <label>Frequency</label>
        <input type="range" id="peakInterval" min="15" max="180" value="45" step="5" class="accent-red">
        <span class="value-badge" id="peakIntervalVal">~45s</span>
      </div>
      <div class="control-item">
        <label>Duration</label>
        <input type="range" id="peakDuration" min="5" max="60" value="12" step="1" class="accent-red">
        <span class="value-badge" id="peakDurationVal">12s</span>
      </div>
    </div>
    <div class="control-group">
      <div class="control-item">
        <label>Intensity</label>
        <input type="range" id="peakIntensity" min="0.1" max="0.9" value="0.4" step="0.05" class="accent-red">
        <span class="value-badge" id="peakIntensityVal">0.40</span>
      </div>
      <div class="control-item">
        <label>Burst Size</label>
        <input type="range" id="peakBurstSize" min="0" max="6" value="2" step="1" class="accent-red">
        <span class="value-badge" id="peakBurstSizeVal">2</span>
      </div>
    </div>

    <div class="preset-row">
      <button class="preset-btn" data-peak-preset="mild">🌤 Mild</button>
      <button class="preset-btn" data-peak-preset="standard">⚡ Standard</button>
      <button class="preset-btn" data-peak-preset="chaotic">🌀 Chaotic</button>
      <button class="preset-btn" data-peak-preset="slammed">🔥 Slammed</button>
    </div>
  </div>

  <!-- Start Peak Now Button - MOVED UNDER PEAK HOURS -->
  <button class="btn btn-danger btn-peak btn-full" id="startPeakBtn" style="margin-top: var(--space-4);">
    🔥 Start Peak Now
  </button>

  <div class="peak-status idle" id="peakStatus">
    <span class="dot idle" id="peakDot"></span>
    <span id="peakStatusText">Peak hours disabled — normal spawn rate</span>
  </div>
</div>

<!-- RAIL PREVIEW -->
<div class="card" style="margin-bottom: var(--space-5);">
  <div class="card-header">
    <h2>🚄 Active Orders</h2>
    <span class="order-count" id="orderCountBadge">0</span>
  </div>
  <div class="mini-rail" id="miniRail">
    <div class="empty-rail">No orders — start service to begin</div>
  </div>
</div>

<!-- LOGS -->
<div class="card">
  <div class="logs-header">
    <h2 style="font-family: var(--font-display); font-size: 20px; margin: 0; color: var(--ink-bright);">📋 System Logs</h2>
    <div class="logs-actions">
      <button class="btn btn-secondary" id="clearLogsBtn" style="padding: 4px 12px; font-size: 11px;">🗑 Clear</button>
      <button class="btn btn-secondary" id="toggleLogsBtn" style="padding: 4px 12px; font-size: 11px;">⬇ Auto</button>
    </div>
  </div>
  <div class="logs-container" id="logsContainer">
    <div class="log-entry">
      <span class="log-time">System</span>
      <span class="log-type info">info</span>
      <span class="log-message">🚀 Dashboard initialized — waiting for game connection...</span>
    </div>
  </div>
</div>

<div style="text-align: center; margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--border-subtle); font-size: 11px; color: var(--ink-faint);">
  Ticket Rail Control Dashboard — All settings apply live. Use "Apply Settings" to push changes to the game.
</div>

<script>
  // =========================================================
  // CONTROL DASHBOARD — Full Implementation
  // =========================================================

  // ----- state -----
  let running = false;
  let paused = false;
  let score = 0, served = 0, missed = 0, failed = 0;
  let serviceRemaining = 300;
  let totalServiceTime = 300;
  let autoScroll = true;
  let activeOrders = [];

  let params = {
    spawnMin: 6,
    spawnMax: 11,
    prepTime: 22,
    rampFactor: 0.92,
    totalTime: 300,
    peakEnabled: false,
    peakInterval: 45,
    peakDuration: 12,
    peakIntensity: 0.4,
    peakBurstSize: 2,
    concurrencyMin: 2,
    concurrencyMax: 5,
    chaos: 0.3,
    minOrdersAlways: 1,
  };

  // DOM refs
  const $ = id => document.getElementById(id);
  const startBtn = $('startBtn');
  const pauseBtn = $('pauseBtn');
  const resetBtn = $('resetBtn');
  const instantOrderBtn = $('instantOrderBtn');
  const startPeakBtn = $('startPeakBtn');
  const sendParamsBtn = $('sendParamsBtn');
  const headerDot = $('headerDot');
  const headerStatus = $('headerStatus');
  const liveDot = $('liveDot');
  const liveLabel = $('liveLabel');
  const espStatus = $('espStatus');
  const orderCountBadge = $('orderCountBadge');

  const spawnMinInput = $('spawnMin');
  const spawnMaxInput = $('spawnMax');
  const prepTimeInput = $('prepTime');
  const rampFactorInput = $('rampFactor');
  const totalTimeInput = $('totalTime');
  const spawnMinVal = $('spawnMinVal');
  const spawnMaxVal = $('spawnMaxVal');
  const prepTimeVal = $('prepTimeVal');
  const rampFactorVal = $('rampFactorVal');
  const totalTimeVal = $('totalTimeVal');

  const concurrencyMinInput = $('concurrencyMin');
  const concurrencyMaxInput = $('concurrencyMax');
  const concurrencyMinVal = $('concurrencyMinVal');
  const concurrencyMaxVal = $('concurrencyMaxVal');
  const minOrdersAlwaysInput = $('minOrdersAlways');
  const minOrdersAlwaysVal = $('minOrdersAlwaysVal');
  const chaosSliderInput = $('chaosSlider');
  const chaosVal = $('chaosVal');
  const chaosBadge = $('chaosBadge');

  const peakEnabledInput = $('peakEnabled');
  const peakControls = $('peakControls');
  const peakBadge = $('peakBadge');
  const peakIntervalInput = $('peakInterval');
  const peakDurationInput = $('peakDuration');
  const peakIntensityInput = $('peakIntensity');
  const peakBurstSizeInput = $('peakBurstSize');
  const peakIntervalVal = $('peakIntervalVal');
  const peakDurationVal = $('peakDurationVal');
  const peakIntensityVal = $('peakIntensityVal');
  const peakBurstSizeVal = $('peakBurstSizeVal');
  const peakStatus = $('peakStatus');
  const peakDot = $('peakDot');
  const peakStatusText = $('peakStatusText');

  const statScore = $('statScore');
  const statServed = $('statServed');
  const statMissed = $('statMissed');
  const statFailed = $('statFailed');
  const serviceTimeEl = $('serviceTime');
  const serviceFillEl = $('serviceFill');
  const miniRail = $('miniRail');
  const logsContainer = $('logsContainer');

  // ----- Logging -----
  function addLog(type, message, data) {
    const time = new Date().toLocaleTimeString();
    const entry = document.createElement('div');
    entry.className = 'log-entry';

    const typeMap = {
      'ESP Received': 'esp',
      'ESP Submit': 'submit',
      'Match Check': 'match',
      '✅ Success': 'success',
      '❌ Error': 'error',
      '📋 Order': 'order',
      '💾 DB': 'db',
      '🔥 Peak': 'peak',
    };
    const typeClass = typeMap[type] || 'info';

    let displayMessage = message;
    if (data) {
      try {
        displayMessage += ' ' + JSON.stringify(data, null, 0);
      } catch(e) { /* ignore */ }
    }

    entry.innerHTML = `
      <span class="log-time">${time}</span>
      <span class="log-type ${typeClass}">${type}</span>
      <span class="log-message">${displayMessage}</span>
    `;
    logsContainer.appendChild(entry);

    if (autoScroll) {
      logsContainer.scrollTop = logsContainer.scrollHeight;
    }

    while (logsContainer.children.length > 500) {
      logsContainer.removeChild(logsContainer.firstChild);
    }
  }

  // ----- Update Chaos Badge -----
  function updateChaosBadge(value) {
    const badge = chaosBadge;
    if (value < 0.15) {
      badge.textContent = 'CALM';
      badge.className = 'badge badge-green';
    } else if (value < 0.4) {
      badge.textContent = 'STEADY';
      badge.className = 'badge badge-amber';
    } else if (value < 0.7) {
      badge.textContent = 'WILD';
      badge.className = 'badge badge-red';
    } else {
      badge.textContent = 'MAYHEM';
      badge.className = 'badge badge-red';
      badge.style.background = 'rgba(217,70,60,0.25)';
      badge.style.color = '#ff6b4a';
    }
  }

  // ----- BroadcastChannel -----
  const channel = new BroadcastChannel('ticket-rail-control');

  channel.onmessage = (event) => {
    const msg = event.data;
    if (!msg) return;

    switch (msg.type) {
      case 'game-ready':
        headerDot.className = 'dot online';
        headerStatus.textContent = 'Connected';
        addLog('info', '✅ Game connected');
        break;

      case 'game-started':
        running = true;
        paused = false;
        addLog('info', '▶ Game started');
        updateUI();
        break;

      case 'game-paused':
        paused = msg.payload.paused;
        addLog('info', paused ? '⏸ Game paused' : '▶ Game resumed');
        updateUI();
        break;

      case 'game-reset':
        running = false;
        paused = false;
        score = 0; served = 0; missed = 0; failed = 0;
        serviceRemaining = totalServiceTime;
        activeOrders = [];
        setPeakStatus(false);
        addLog('info', '⟳ Game reset');
        updateUI();
        renderMiniRail();
        break;

      case 'state-report':
        const state = msg.payload;
        running = state.running;
        paused = state.paused;
        score = state.score || 0;
        served = state.served || 0;
        missed = state.missed || 0;
        failed = state.failed || 0;
        if (state.serviceRemaining !== undefined) {
          serviceRemaining = state.serviceRemaining;
        }
        if (state.totalServiceTime) {
          totalServiceTime = state.totalServiceTime;
        }
        updateUI();
        break;

      case 'order-spawned':
        const newOrder = msg.payload;
        if (!activeOrders.some(o => o.orderNo === newOrder.orderNo)) {
          activeOrders.push(newOrder);
          addLog('📋 Order', `🆕 Order ${newOrder.orderNo} - ${newOrder.dish}`, {
            prep: newOrder.duration + 's',
            points: newOrder.points
          });
          renderMiniRail();
        }
        break;

      case 'orders-snapshot':
        const snapshot = msg.payload || [];
        snapshot.forEach(s => {
          const existing = activeOrders.find(o => o.orderNo === s.orderNo);
          if (existing) {
            existing.remaining = s.remaining;
            existing.status = s.status;
          } else {
            activeOrders.push({ orderNo: s.orderNo, dish: s.dish, remaining: s.remaining, status: s.status });
          }
        });
        const liveNos = new Set(snapshot.map(s => s.orderNo));
        activeOrders = activeOrders.filter(o => liveNos.has(o.orderNo) || ['completed','failed','missed'].includes(o.status));
        renderMiniRail();
        break;

      case 'esp-submit-result':
        if (msg.payload.success) {
          addLog('✅ Success', `🎉 Order ${msg.payload.order_number} completed!`, {
            score: msg.payload.score_earned,
            food: msg.payload.food
          });
          const idx = activeOrders.findIndex(o => o.orderNo === msg.payload.order_number || o.orderNo === msg.payload.display_order_number);
          if (idx !== -1) {
            activeOrders[idx].status = 'completed';
            activeOrders[idx].success = true;
            renderMiniRail();
          }
        } else {
          addLog('❌ Error', `❌ Order ${msg.payload.order_number} failed`, {
            reason: msg.payload.reason || 'Validation failed'
          });
          const idx = activeOrders.findIndex(o => o.orderNo === msg.payload.order_number || o.orderNo === msg.payload.display_order_number);
          if (idx !== -1) {
            activeOrders[idx].status = 'failed';
            activeOrders[idx].success = false;
            renderMiniRail();
          }
        }
        break;

      case 'esp-status':
        const status = msg.payload;
        if (status.online) {
          espStatus.textContent = '✅ Online';
          espStatus.className = 'esp-status online';
          addLog('info', '✅ ESP device online');
        } else {
          espStatus.textContent = '❌ Offline';
          espStatus.className = 'esp-status offline';
          addLog('info', '❌ ESP device offline');
        }
        break;

      case 'peak-hour':
        addLog('🔥 Peak', `🔥 Peak started — ${msg.payload.duration}s`);
        setPeakStatus(true, msg.payload.duration);
        break;

      case 'peak-ended':
        addLog('🔥 Peak', '⏹ Peak ended');
        setPeakStatus(false);
        break;

      default:
        console.log('📨 Unknown message:', msg);
    }
  };

  // ----- UI Updates -----
  function updateUI() {
    if (running && !paused) {
      liveDot.className = 'dot online';
      liveLabel.textContent = 'running';
      startBtn.disabled = true;
      pauseBtn.disabled = false;
      pauseBtn.textContent = '⏸ Pause';
      headerDot.className = 'dot online';
      headerStatus.textContent = 'Running';
    } else if (running && paused) {
      liveDot.className = 'dot idle';
      liveLabel.textContent = 'paused';
      startBtn.disabled = true;
      pauseBtn.disabled = false;
      pauseBtn.textContent = '▶ Resume';
      headerDot.className = 'dot idle';
      headerStatus.textContent = 'Paused';
    } else {
      liveDot.className = 'dot idle';
      liveLabel.textContent = 'idle';
      startBtn.disabled = false;
      pauseBtn.disabled = true;
      pauseBtn.textContent = '⏸ Pause';
      headerDot.className = 'dot idle';
      headerStatus.textContent = 'Idle';
    }

    statScore.textContent = score;
    statServed.textContent = served;
    statMissed.textContent = missed;
    statFailed.textContent = failed || 0;

    const m = Math.floor(Math.max(0, serviceRemaining) / 60).toString().padStart(2, '0');
    const s = Math.floor(Math.max(0, serviceRemaining) % 60).toString().padStart(2, '0');
    serviceTimeEl.textContent = `${m}:${s}`;
    serviceFillEl.style.width = Math.max(0, (serviceRemaining / totalServiceTime) * 100) + '%';
  }

  function renderMiniRail() {
    orderCountBadge.textContent = activeOrders.length;

    if (!activeOrders.length) {
      miniRail.innerHTML = `<div class="empty-rail">No orders — start service to begin</div>`;
      return;
    }

    miniRail.innerHTML = activeOrders.map(o => {
      const tilt = (Math.random() * 3 - 1.5).toFixed(1) + 'deg';
      const statusClass = o.status || 'waiting';
      const timeLeft = o.remaining !== undefined ? Math.ceil(o.remaining) : '?';
      return `<div class="mini-ticket" style="--tilt:${tilt}">
        <span class="dish">${o.dish}</span>
        <span class="time">${timeLeft}s</span>
        <span class="status ${statusClass}">${statusClass}</span>
      </div>`;
    }).join('');
  }

  // ----- Peak Status -----
  let peakClearTimeout = null;

  function setPeakStatus(active, duration, manual) {
    if (peakClearTimeout) clearTimeout(peakClearTimeout);

    if (!params.peakEnabled && !manual) {
      peakStatus.className = 'peak-status idle';
      peakDot.className = 'dot idle';
      peakStatusText.textContent = 'Peak hours disabled — normal spawn rate';
      return;
    }

    if (active) {
      peakStatus.className = manual ? 'peak-status manual' : 'peak-status active';
      peakDot.className = manual ? 'dot manual' : 'dot active';
      peakStatusText.textContent = `🔥 Peak active${duration ? ` (${duration}s)` : ''}${manual ? ' — manual trigger' : ''}`;
      if (duration) {
        peakClearTimeout = setTimeout(() => {
          setPeakStatus(false);
          channel.postMessage({ type: 'peak-ended' });
        }, duration * 1000);
      }
    } else {
      peakStatus.className = 'peak-status idle';
      peakDot.className = 'dot idle';
      peakStatusText.textContent = params.peakEnabled ? 'Waiting for next peak window' : 'Peak hours disabled — normal spawn rate';
    }
  }

  // ----- Read Params -----
  function readParamsFromUI() {
    params.spawnMin = parseFloat(spawnMinInput.value);
    params.spawnMax = parseFloat(spawnMaxInput.value);
    params.prepTime = parseFloat(prepTimeInput.value);
    params.rampFactor = parseFloat(rampFactorInput.value);
    params.totalTime = parseFloat(totalTimeInput.value);
    params.concurrencyMin = parseInt(concurrencyMinInput.value, 10);
    params.concurrencyMax = parseInt(concurrencyMaxInput.value, 10);
    params.minOrdersAlways = parseInt(minOrdersAlwaysInput.value, 10);
    params.chaos = parseFloat(chaosSliderInput.value);
    params.peakEnabled = peakEnabledInput.checked;
    params.peakInterval = parseFloat(peakIntervalInput.value);
    params.peakDuration = parseFloat(peakDurationInput.value);
    params.peakIntensity = parseFloat(peakIntensityInput.value);
    params.peakBurstSize = parseInt(peakBurstSizeInput.value, 10);

    spawnMinVal.textContent = params.spawnMin + 's';
    spawnMaxVal.textContent = params.spawnMax + 's';
    prepTimeVal.textContent = params.prepTime + 's';
    rampFactorVal.textContent = params.rampFactor.toFixed(2);
    concurrencyMinVal.textContent = params.concurrencyMin;
    concurrencyMaxVal.textContent = params.concurrencyMax;
    minOrdersAlwaysVal.textContent = params.minOrdersAlways;
    chaosVal.textContent = params.chaos.toFixed(2);
    updateChaosBadge(params.chaos);

    const mins = Math.floor(params.totalTime / 60);
    const secs = Math.floor(params.totalTime % 60);
    totalTimeVal.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;

    peakIntervalVal.textContent = '~' + params.peakInterval + 's';
    peakDurationVal.textContent = params.peakDuration + 's';
    peakIntensityVal.textContent = params.peakIntensity.toFixed(2);
    peakBurstSizeVal.textContent = params.peakBurstSize;

    peakBadge.textContent = params.peakEnabled ? 'ON' : 'OFF';
    peakBadge.className = params.peakEnabled ? 'badge badge-red' : 'badge badge-dim';
    peakControls.style.opacity = params.peakEnabled ? '1' : '0.4';
    peakControls.style.pointerEvents = params.peakEnabled ? 'auto' : 'none';

    setPeakStatus(false);
  }

  // ----- Send Params -----
  function sendParamsToGame() {
    readParamsFromUI();
    channel.postMessage({
      type: 'params',
      payload: { ...params }
    });
    totalServiceTime = params.totalTime;
    if (!running && serviceRemaining <= 0) {
      serviceRemaining = totalServiceTime;
    }
    updateUI();
    addLog('info', '📤 Parameters sent to game', params);
  }

  // ----- Event Listeners -----
  sendParamsBtn.addEventListener('click', sendParamsToGame);

  // Start Peak Now - MOVED under Peak Hours
  startPeakBtn.addEventListener('click', () => {
    const duration = parseFloat(peakDurationInput.value) || 12;
    const burstSize = parseInt(peakBurstSizeInput.value, 10) || 2;
    const intensity = parseFloat(peakIntensityInput.value) || 0.4;
    
    // Send manual peak trigger to game via BroadcastChannel
    channel.postMessage({
      type: 'manual-peak',
      payload: { 
        duration: duration, 
        burstSize: burstSize, 
        intensity: intensity 
      }
    });
    
    // Also send force-peak for compatibility
    channel.postMessage({ 
      type: 'force-peak' 
    });
    
    // Update UI
    setPeakStatus(true, duration, true);
    addLog('🔥 Peak', `🔥 Manual peak triggered — ${duration}s, ${burstSize} burst, intensity ${intensity}`);
    
    // Show visual feedback
    startPeakBtn.textContent = '🔥 Peak Active!';
    startPeakBtn.style.background = '#ff6b4a';
    setTimeout(() => {
      startPeakBtn.textContent = '🔥 Start Peak Now';
      startPeakBtn.style.background = '';
    }, duration * 1000 + 1000);
  });

  // Peak Presets
  document.querySelectorAll('[data-peak-preset]').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.peakPreset;
      let interval, duration, intensity, burst;
      switch (preset) {
        case 'mild': interval=70; duration=8; intensity=0.6; burst=1; break;
        case 'standard': interval=45; duration=12; intensity=0.4; burst=2; break;
        case 'chaotic': interval=30; duration=15; intensity=0.25; burst=3; break;
        case 'slammed': interval=20; duration=20; intensity=0.15; burst=4; break;
        default: return;
      }
      peakEnabledInput.checked = true;
      peakIntervalInput.value = interval;
      peakDurationInput.value = duration;
      peakIntensityInput.value = intensity;
      peakBurstSizeInput.value = burst;
      readParamsFromUI();
      sendParamsToGame();
      addLog('🔥 Peak', `🔥 Peak preset: ${preset}`, { interval, duration, intensity, burst });
    });
  });

  // Service Controls
  startBtn.addEventListener('click', () => {
    channel.postMessage({ type: 'start' });
    addLog('info', '▶ Start command sent');
  });

  pauseBtn.addEventListener('click', () => {
    channel.postMessage({ type: 'pause' });
  });

  resetBtn.addEventListener('click', resetService);

  async function resetService() {
    addLog('info', '⟳ Reset command sent');
    try {
      const response = await fetch('/api/orders/clear', { method: 'POST' });
      const data = await response.json();
      if (data.success) {
        addLog('💾 DB', `✅ Database cleared: ${data.orders_cleared} orders`);
      }
    } catch (err) {
      addLog('❌ Error', `Database clear failed: ${err.message}`);
    }
    channel.postMessage({ type: 'reset' });
    running = false; paused = false;
    score = 0; served = 0; missed = 0; failed = 0;
    serviceRemaining = totalServiceTime;
    activeOrders = [];
    setPeakStatus(false);
    updateUI();
    renderMiniRail();
  }

  instantOrderBtn.addEventListener('click', () => {
    channel.postMessage({ type: 'force-spawn' });
    addLog('📋 Order', '⚡ Instant order requested');
  });

  // ESP Status
  document.getElementById('refreshEspBtn').addEventListener('click', async () => {
    try {
      const response = await fetch('/api/esp/status');
      const data = await response.json();
      if (data.online) {
        espStatus.textContent = '✅ Online';
        espStatus.className = 'esp-status online';
        addLog('info', '✅ ESP device online');
      } else {
        espStatus.textContent = '❌ Offline';
        espStatus.className = 'esp-status offline';
        addLog('info', '❌ ESP device offline');
      }
    } catch (error) {
      espStatus.textContent = '⚠️ Error';
      espStatus.className = 'esp-status offline';
      addLog('❌ Error', `ESP check failed: ${error.message}`);
    }
  });

  // Log controls
  document.getElementById('clearLogsBtn').addEventListener('click', () => {
    logsContainer.innerHTML = '';
    addLog('info', '🗑 Logs cleared');
  });

  document.getElementById('toggleLogsBtn').addEventListener('click', () => {
    autoScroll = !autoScroll;
    document.getElementById('toggleLogsBtn').textContent = autoScroll ? '⬇ Auto' : '⬆ Manual';
    addLog('info', autoScroll ? '⬇ Auto-scroll enabled' : '⬆ Auto-scroll disabled');
  });

  // Input listeners
  [spawnMinInput, spawnMaxInput, prepTimeInput, rampFactorInput, totalTimeInput,
   peakIntervalInput, peakDurationInput, peakIntensityInput, peakBurstSizeInput,
   concurrencyMinInput, concurrencyMaxInput, minOrdersAlwaysInput
  ].forEach(input => {
    input.addEventListener('input', readParamsFromUI);
  });

  chaosSliderInput.addEventListener('input', () => {
    const val = parseFloat(chaosSliderInput.value);
    chaosVal.textContent = val.toFixed(2);
    updateChaosBadge(val);
    readParamsFromUI();
  });

  peakEnabledInput.addEventListener('change', () => {
    readParamsFromUI();
    addLog('🔥 Peak', peakEnabledInput.checked ? '🔥 Peak hours enabled' : '⏹ Peak hours disabled');
    sendParamsToGame();
  });

  // ----- Init -----
  readParamsFromUI();
  updateUI();
  renderMiniRail();

  setTimeout(() => {
    sendParamsToGame();
    channel.postMessage({ type: 'state' });
    addLog('info', '🔄 Requesting game state...');
  }, 500);

  setInterval(() => {
    channel.postMessage({ type: 'state' });
  }, 5000);

  setInterval(() => {
    document.getElementById('refreshEspBtn').click();
  }, 30000);

  addLog('info', '🚀 Dashboard initialized');
  console.log('🎛 Ticket Rail Controller ready');
</script>
</body>
</html>