<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket Rail — Control Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Courier+Prime:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(ellipse at top, #363c40 0%, #24282b 60%);
      font-family: 'Inter', sans-serif;
      color: #e9e6de;
      padding: 20px 32px 40px;
    }
    .brand {
      display: flex;
      align-items: baseline;
      gap: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding-bottom: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .brand h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 32px;
      letter-spacing: 3px;
      margin: 0;
      color: #f5f2ea;
    }
    .brand span.sub {
      font-size: 11px;
      letter-spacing: 2px;
      color: #6b6558;
      text-transform: uppercase;
    }
    .panel-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }
    @media (max-width: 800px) {
      .panel-grid { grid-template-columns: 1fr; }
    }
    .card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 20px 24px;
      backdrop-filter: blur(2px);
    }
    .card h2 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 22px;
      letter-spacing: 1px;
      margin: 0 0 16px 0;
      color: #f0ede4;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding-bottom: 8px;
    }
    .control-group {
      display: flex;
      flex-wrap: wrap;
      gap: 16px 24px;
      align-items: center;
    }
    .control-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
    }
    .control-item label {
      color: #b5aea0;
      font-weight: 500;
      min-width: 70px;
    }
    .control-item input[type="range"] {
      width: 200px;
      accent-color: #4a9d6e;
      background: #2f3438;
      height: 4px;
      border-radius: 2px;
    }
    .control-item input[type="number"] {
      width: 72px;
      background: #1e2124;
      border: 1px solid #3d4347;
      color: #f5f2ea;
      padding: 6px 8px;
      border-radius: 6px;
      font-family: 'Courier Prime', monospace;
      font-size: 14px;
    }
    .control-item .value-badge {
      background: #1e2124;
      padding: 4px 12px;
      border-radius: 20px;
      font-family: 'Courier Prime', monospace;
      font-size: 13px;
      color: #b5aea0;
      min-width: 60px;
      text-align: center;
    }
    .preset-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 12px;
    }
    .preset-btn {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: #e9e6de;
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.3px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .preset-btn:hover {
      background: rgba(74, 157, 110, 0.2);
      border-color: #4a9d6e;
    }
    .stat-row {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      background: rgba(0,0,0,0.2);
      border-radius: 40px;
      padding: 8px 20px;
      margin-top: 6px;
    }
    .stat-item {
      display: flex;
      align-items: baseline;
      gap: 6px;
      font-size: 13px;
      color: #b5aea0;
    }
    .stat-item .num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 26px;
      color: #f5f2ea;
      letter-spacing: 0.5px;
    }
    .stat-item .num.warn { color: #dfa62e; }
    .stat-item .num.danger { color: #d9463c; }
    .toggle-btn {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      color: #f5f2ea;
      padding: 10px 24px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: 0.15s;
      font-family: 'Inter', sans-serif;
    }
    .toggle-btn.active {
      background: #4a9d6e;
      border-color: #4a9d6e;
      color: #12241a;
    }
    .toggle-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
    .toggle-btn:active { transform: scale(0.96); }
    .footnote {
      font-family: 'Courier Prime', monospace;
      font-size: 11px;
      color: #6b6558;
      margin-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.04);
      padding-top: 16px;
      text-align: center;
    }
    .live-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #4a9d6e;
      margin-right: 8px;
      box-shadow: 0 0 8px #4a9d6e;
      transition: 0.2s;
    }
    .live-indicator.paused { background: #dfa62e; box-shadow: 0 0 8px #dfa62e; }
    .live-indicator.off { background: #6b6558; box-shadow: none; }

    .mini-rail {
      display: flex;
      gap: 12px;
      padding: 12px 0;
      overflow-x: auto;
      min-height: 60px;
      align-items: center;
    }
    .mini-rail::-webkit-scrollbar { height: 6px; }
    .mini-rail::-webkit-scrollbar-thumb { background: #4a5054; border-radius: 3px; }
    .mini-ticket {
      background: #f3ecd8;
      color: #26241f;
      padding: 8px 12px;
      border-radius: 4px;
      font-family: 'Courier Prime', monospace;
      font-size: 11px;
      white-space: nowrap;
      box-shadow: 0 4px 8px rgba(0,0,0,0.3);
      transform: rotate(var(--tilt, 0deg));
      flex: 0 0 auto;
      animation: miniDrop 0.3s ease-out;
    }
    @keyframes miniDrop {
      from { transform: translateY(-10px) rotate(var(--tilt, 0deg)); opacity: 0; }
      to { transform: translateY(0) rotate(var(--tilt, 0deg)); opacity: 1; }
    }
    .mini-ticket .dish { font-weight: 700; font-size: 13px; }
    .mini-ticket .time { color: #6b6558; font-size: 10px; }
    .mini-ticket .status-badge-mini {
      font-size: 8px;
      padding: 1px 6px;
      border-radius: 8px;
      margin-left: 4px;
      font-weight: 600;
    }
    .mini-ticket .status-badge-mini.waiting { background: #dfa62e; color: #2d2410; }
    .mini-ticket .status-badge-mini.completed { background: #4a9d6e; color: #12241a; }
    .mini-ticket .status-badge-mini.missed { background: #d9463c; color: #fff; }
    .mini-ticket .status-badge-mini.failed { background: #d9463c; color: #fff; }
    .mini-ticket .status-badge-mini.cooking { background: #e3ddc6; color: #5a5334; }
    
    .empty-rail-mini {
      color: #6b6558;
      font-family: 'Courier Prime', monospace;
      font-size: 12px;
      padding: 12px 0;
    }
    .connection-status {
      padding: 8px 16px;
      border-radius: 20px;
      background: rgba(0,0,0,0.3);
      font-size: 12px;
      font-family: 'Courier Prime', monospace;
      display: inline-block;
    }
    .connection-status.connected { border-left: 3px solid #4a9d6e; }
    .connection-status.disconnected { border-left: 3px solid #d9463c; }
    .connection-status.syncing { border-left: 3px solid #dfa62e; }
    .nav-link {
      color: #b5aea0;
      text-decoration: none;
      font-size: 13px;
      padding: 6px 14px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      transition: 0.15s;
    }
    .nav-link:hover {
      background: rgba(255,255,255,0.05);
      color: #f5f2ea;
    }

    /* Logs Section */
    .logs-container {
      max-height: 300px;
      overflow-y: auto;
      background: rgba(0,0,0,0.3);
      border-radius: 8px;
      padding: 12px;
      font-family: 'Courier Prime', monospace;
      font-size: 12px;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .logs-container::-webkit-scrollbar {
      width: 6px;
    }
    .logs-container::-webkit-scrollbar-thumb {
      background: #4a5054;
      border-radius: 3px;
    }
    .log-entry {
      padding: 4px 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      display: flex;
      gap: 12px;
      align-items: baseline;
    }
    .log-time {
      color: #6b6558;
      font-size: 10px;
      min-width: 80px;
    }
    .log-type {
      font-size: 10px;
      padding: 1px 8px;
      border-radius: 10px;
      font-weight: 600;
      min-width: 70px;
      text-align: center;
    }
    .log-type.info { background: #1a3a5c; color: #6cb4ee; }
    .log-type.success { background: #1a4a2a; color: #4a9d6e; }
    .log-type.error { background: #4a1a1a; color: #d9463c; }
    .log-type.esp { background: #4a3a1a; color: #dfa62e; }
    .log-type.match { background: #1a3a3a; color: #4ad6d6; }
    .log-type.submit { background: #3a1a4a; color: #c96ad6; }
    .log-type.order { background: #1a2a4a; color: #6cb4ee; }
    .log-type.db { background: #1a4a1a; color: #4a9d6e; }
    .log-message { color: #e9e6de; word-break: break-all; }

    .esp-status-indicator {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
    }
    .esp-status-indicator.online { background: #1a4a2a; color: #4a9d6e; }
    .esp-status-indicator.offline { background: #4a1a1a; color: #d9463c; }
    .esp-status-indicator.waiting { background: #4a3a1a; color: #dfa62e; }

    .clear-logs-btn {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: #b5aea0;
      padding: 4px 16px;
      border-radius: 20px;
      font-size: 11px;
      cursor: pointer;
      transition: 0.15s;
      font-family: 'Inter', sans-serif;
    }
    .clear-logs-btn:hover {
      background: rgba(255,255,255,0.08);
      color: #f5f2ea;
    }

    .order-count-badge {
      background: #4a9d6e;
      color: #12241a;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      margin-left: 8px;
    }
  </style>
</head>
<body>

<div class="brand">
  <h1>Ticket Rail</h1>
  <span class="sub">Control Dashboard</span>
  <span style="margin-left: auto; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
    <a href="/game" class="nav-link">🎮 Go to Game</a>
    <span class="connection-status connected" id="connectionStatus">✅ Game connected</span>
    <span style="display: flex; align-items: center; gap: 6px; font-size: 13px; color: #b5aea0;">
      <span class="live-indicator off" id="liveDot"></span>
      <span id="liveLabel">idle</span>
    </span>
  </span>
</div>

<div class="panel-grid">
  <!-- TIMING & FREQUENCY -->
  <div class="card">
    <h2>⏱ Timing & frequency</h2>
    <div class="control-group">
      <div class="control-item">
        <label>Order min</label>
        <input type="range" id="spawnMin" min="1" max="60" value="6" step="0.5">
        <span class="value-badge" id="spawnMinVal">6s</span>
      </div>
      <div class="control-item">
        <label>Order max</label>
        <input type="range" id="spawnMax" min="2" max="120" value="11" step="0.5">
        <span class="value-badge" id="spawnMaxVal">11s</span>
      </div>
    </div>
    <div class="control-group" style="margin-top: 12px;">
      <div class="control-item">
        <label>Prep time</label>
        <input type="range" id="prepTime" min="5" max="300" value="22" step="1">
        <span class="value-badge" id="prepTimeVal">22s</span>
      </div>
      <div class="control-item">
        <label>Ramp factor</label>
        <input type="range" id="rampFactor" min="0.5" max="1.0" value="0.92" step="0.02">
        <span class="value-badge" id="rampFactorVal">0.92</span>
      </div>
    </div>
    <div class="control-group" style="margin-top: 12px;">
      <div class="control-item" style="flex: 1;">
        <label style="min-width: 100px;">Total service time</label>
        <input type="range" id="totalTime" min="60" max="3600" value="300" step="30">
        <span class="value-badge" id="totalTimeVal">5:00</span>
      </div>
    </div>
    <div class="preset-row">
      <button class="preset-btn" data-preset="quick">Quick (2 min)</button>
      <button class="preset-btn" data-preset="normal">Normal (5 min)</button>
      <button class="preset-btn" data-preset="long">Long (15 min)</button>
      <button class="preset-btn" data-preset="marathon">Marathon (30 min)</button>
      <button class="preset-btn" data-preset="endurance">Endurance (60 min)</button>
    </div>
    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.06);">
      <button class="toggle-btn" id="sendParamsBtn" style="width:100%;">📤 Send Parameters to Game</button>
    </div>
  </div>

  <!-- SERVICE CONTROLS + STATS -->
  <div class="card">
    <h2>🎛 Service controls</h2>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
      <button class="toggle-btn" id="startBtn">▶ Start</button>
      <button class="toggle-btn" id="pauseBtn" disabled>⏸ Pause</button>
      <button class="toggle-btn" id="resetBtn">⟳ Reset</button>
    </div>
    <div class="stat-row">
      <div class="stat-item"><span class="num" id="statScore">0</span> score</div>
      <div class="stat-item"><span class="num" id="statServed">0</span> served</div>
      <div class="stat-item"><span class="num" id="statMissed">0</span> missed</div>
      <div class="stat-item"><span class="num" id="statFailed">0</span> failed</div>
    </div>
    <div style="margin-top: 16px; display: flex; align-items: center; gap: 16px;">
      <span style="font-size:13px; color:#b5aea0;">Service clock</span>
      <span style="font-family:'Bebas Neue',sans-serif; font-size:24px;" id="serviceTime">05:00</span>
      <div style="flex:1; height:6px; background:rgba(255,255,255,0.08); border-radius:3px; overflow:hidden;">
        <div id="serviceFill" style="height:100%; width:100%; background:linear-gradient(90deg,#4a9d6e,#dfa62e 70%,#d9463c); transition:width 0.5s;"></div>
      </div>
    </div>
    <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.06);">
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <span style="font-size:12px; color:#b5aea0;">ESP Status:</span>
        <span class="esp-status-indicator waiting" id="espStatus">⏳ Waiting</span>
        <button class="clear-logs-btn" id="refreshEspBtn">🔄 Refresh</button>
      </div>
    </div>
  </div>
</div>

<!-- RAIL PREVIEW (mini) -->
<div class="card" style="margin-bottom: 24px;">
  <h2>🚄 Active orders (preview) <span class="order-count-badge" id="orderCountBadge">0</span></h2>
  <div class="mini-rail" id="miniRail">
    <div class="empty-rail-mini">No orders — start service to see them appear.</div>
  </div>
</div>

<!-- LOGS SECTION -->
<div class="card" style="margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
    <h2 style="margin:0;">📋 System Logs</h2>
    <div style="display: flex; gap: 8px;">
      <button class="clear-logs-btn" id="clearLogsBtn">🗑 Clear</button>
      <button class="clear-logs-btn" id="toggleLogsBtn">⬇ Auto-scroll</button>
    </div>
  </div>
  <div class="logs-container" id="logsContainer">
    <div class="log-entry">
      <span class="log-time">System</span>
      <span class="log-type info">info</span>
      <span class="log-message">🔄 Dashboard initialized. Waiting for game connection...</span>
    </div>
  </div>
</div>

<div class="footnote">
  This dashboard controls timing & frequency. Use the "Send Parameters" button to update the game.
  The game page shows the full ticket rail. ESP messages and order validation are logged here.
</div>

<script>
  /* =========================================================
     CONTROL DASHBOARD — Extended timing controls with Logs
     ========================================================= */

  // ----- state -----
  let running = false;
  let paused = false;
  let score = 0, served = 0, missed = 0, failed = 0;
  let serviceRemaining = 300;
  let totalServiceTime = 300;
  let orderCounter = 0;
  let autoScroll = true;
  let activeOrders = [];

  // timing parameters
  let params = {
    spawnMin: 6,
    spawnMax: 11,
    prepTime: 22,
    rampFactor: 0.92,
    totalTime: 300,
  };

  // DOM refs
  const startBtn = document.getElementById('startBtn');
  const pauseBtn = document.getElementById('pauseBtn');
  const resetBtn = document.getElementById('resetBtn');
  const sendParamsBtn = document.getElementById('sendParamsBtn');
  const liveDot = document.getElementById('liveDot');
  const liveLabel = document.getElementById('liveLabel');
  const connectionStatus = document.getElementById('connectionStatus');
  const espStatus = document.getElementById('espStatus');
  const orderCountBadge = document.getElementById('orderCountBadge');

  const spawnMinInput = document.getElementById('spawnMin');
  const spawnMaxInput = document.getElementById('spawnMax');
  const prepTimeInput = document.getElementById('prepTime');
  const rampFactorInput = document.getElementById('rampFactor');
  const totalTimeInput = document.getElementById('totalTime');
  const spawnMinVal = document.getElementById('spawnMinVal');
  const spawnMaxVal = document.getElementById('spawnMaxVal');
  const prepTimeVal = document.getElementById('prepTimeVal');
  const rampFactorVal = document.getElementById('rampFactorVal');
  const totalTimeVal = document.getElementById('totalTimeVal');

  const statScore = document.getElementById('statScore');
  const statServed = document.getElementById('statServed');
  const statMissed = document.getElementById('statMissed');
  const statFailed = document.getElementById('statFailed');
  const serviceTimeEl = document.getElementById('serviceTime');
  const serviceFillEl = document.getElementById('serviceFill');
  const miniRail = document.getElementById('miniRail');
  const logsContainer = document.getElementById('logsContainer');

  // ----- Logging -----
  function addLog(type, message, data) {
    const time = new Date().toLocaleTimeString();
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    
    let typeClass = 'info';
    switch(type) {
      case 'ESP Received': typeClass = 'esp'; break;
      case 'ESP Submit': typeClass = 'submit'; break;
      case 'Match Check': typeClass = 'match'; break;
      case '✅ Success': typeClass = 'success'; break;
      case '❌ Error': typeClass = 'error'; break;
      case '📋 Order': typeClass = 'order'; break;
      case '💾 DB': typeClass = 'db'; break;
      default: typeClass = 'info';
    }
    
    let displayMessage = message;
    if (data) {
      try {
        displayMessage += ' ' + JSON.stringify(data, null, 0);
      } catch(e) {
        displayMessage += ' [data]';
      }
    }
    
    entry.innerHTML = `
      <span class="log-time">${time}</span>
      <span class="log-type ${typeClass}">${type}</span>
      <span class="log-message">${displayMessage}</span>
    `;
    logsContainer.appendChild(entry);
    
    if (autoScroll) {
      logsContainer.scrollTop = logsContainer.scrollHeight;
    }
    
    // Keep last 500 logs
    while (logsContainer.children.length > 500) {
      logsContainer.removeChild(logsContainer.firstChild);
    }
  }

  // ----- BroadcastChannel for communication -----
  const channel = new BroadcastChannel('ticket-rail-control');

  // Listen for messages from the game
  channel.onmessage = (event) => {
    const msg = event.data;
    if (!msg) return;

    console.log('📨 Dashboard received:', msg);

    switch (msg.type) {
      case 'game-ready':
        connectionStatus.textContent = '✅ Game connected';
        connectionStatus.className = 'connection-status connected';
        addLog('info', '✅ Game connected');
        break;

      case 'game-started':
        running = true;
        paused = false;
        addLog('info', '▶ Game started');
        updateUI();
        break;

      case 'game-paused':
        paused = msg.payload.paused;
        addLog('info', paused ? '⏸ Game paused' : '▶ Game resumed');
        updateUI();
        break;

      case 'game-reset':
        running = false;
        paused = false;
        score = 0; served = 0; missed = 0; failed = 0;
        serviceRemaining = totalServiceTime;
        activeOrders = [];
        addLog('info', '⟳ Game reset');
        updateUI();
        renderMiniRail();
        break;

      case 'state-report':
        const state = msg.payload;
        running = state.running;
        paused = state.paused;
        score = state.score || 0;
        served = state.served || 0;
        missed = state.missed || 0;
        failed = state.failed || 0;
        if (state.serviceRemaining !== undefined) {
          serviceRemaining = state.serviceRemaining;
        }
        if (state.totalServiceTime) {
          totalServiceTime = state.totalServiceTime;
        }
        updateUI();
        break;

      case 'order-spawned':
        // New order spawned in game
        const newOrder = msg.payload;
        const exists = activeOrders.some(o => o.orderNo === newOrder.orderNo);
        if (!exists) {
          activeOrders.push(newOrder);
          addLog('📋 Order', `🆕 Order ${newOrder.orderNo} spawned - ${newOrder.dish}`, {
            prepTime: newOrder.duration,
            points: newOrder.points
          });
          renderMiniRail();
        }
        break;

      case 'order-complete':
        const completePayload = msg.payload;
        const orderIndex = activeOrders.findIndex(o => o.orderNo === completePayload.orderNo || o.orderNo === completePayload.order_number);
        if (orderIndex !== -1) {
          const order = activeOrders[orderIndex];
          order.status = completePayload.status || 'completed';
          if (completePayload.success !== undefined) {
            order.success = completePayload.success;
          }
          if (completePayload.score_earned !== undefined) {
            order.scoreEarned = completePayload.score_earned;
          }
          addLog('📋 Order', `📦 Order ${order.orderNo} ${order.status}`, {
            food: order.dish,
            score: order.scoreEarned || 0
          });
          
          setTimeout(() => {
            activeOrders = activeOrders.filter(o => o.orderNo !== order.orderNo);
            renderMiniRail();
          }, 2000);
          
          renderMiniRail();
        }
        break;

      case 'esp-action':
        addLog('ESP Received', `📡 ${msg.payload.tag_mac} → ${msg.payload.action_name}`, {
          tagger: msg.payload.tagger_mac,
          order: msg.payload.order_number || 'no order'
        });
        break;

      case 'esp-submit':
        addLog('ESP Submit', `📤 Order ${msg.payload.order_number} submitted`, {
          device: msg.payload.device_mac,
          result: msg.payload.result
        });
        break;

      case 'esp-match-check':
        addLog('Match Check', `🔍 ${msg.payload.ingredient}: expected "${msg.payload.expected}" got "${msg.payload.got}"`, {
          pass: msg.payload.pass
        });
        break;

      case 'esp-submit-result':
        if (msg.payload.success) {
          addLog('✅ Success', `🎉 Order ${msg.payload.order_number} COMPLETED!`, {
            score: msg.payload.score_earned,
            food: msg.payload.food
          });
          const orderIdx = activeOrders.findIndex(o => o.orderNo === msg.payload.order_number || o.orderNo === msg.payload.display_order_number);
          if (orderIdx !== -1) {
            activeOrders[orderIdx].status = 'completed';
            activeOrders[orderIdx].success = true;
            activeOrders[orderIdx].scoreEarned = msg.payload.score_earned;
            renderMiniRail();
          }
        } else {
          addLog('❌ Error', `❌ Order ${msg.payload.order_number} FAILED`, {
            reason: msg.payload.reason || 'Validation failed'
          });
          const orderIdx = activeOrders.findIndex(o => o.orderNo === msg.payload.order_number || o.orderNo === msg.payload.display_order_number);
          if (orderIdx !== -1) {
            activeOrders[orderIdx].status = 'failed';
            activeOrders[orderIdx].success = false;
            renderMiniRail();
          }
        }
        break;

      case 'orders-cleared':
        addLog('💾 DB', `🗑 Database cleared: ${msg.payload.orders_cleared || 0} orders removed, tags reset`);
        break;

      case 'esp-status':
        const status = msg.payload;
        if (status.online) {
          espStatus.textContent = '✅ ESP Online';
          espStatus.className = 'esp-status-indicator online';
          addLog('info', '✅ ESP device is online');
        } else {
          espStatus.textContent = '❌ ESP Offline';
          espStatus.className = 'esp-status-indicator offline';
          addLog('info', '❌ No ESP devices online');
        }
        break;

      default:
        console.log('📨 unknown message:', msg);
    }
  };

  // ----- UI updates -----
  function updateUI() {
    if (running && !paused) {
      liveDot.className = 'live-indicator';
      liveLabel.textContent = 'running';
      startBtn.disabled = true;
      pauseBtn.disabled = false;
      pauseBtn.textContent = '⏸ Pause';
    } else if (running && paused) {
      liveDot.className = 'live-indicator paused';
      liveLabel.textContent = 'paused';
      startBtn.disabled = true;
      pauseBtn.disabled = false;
      pauseBtn.textContent = '▶ Resume';
    } else {
      liveDot.className = 'live-indicator off';
      liveLabel.textContent = 'idle';
      startBtn.disabled = false;
      pauseBtn.disabled = true;
      pauseBtn.textContent = '⏸ Pause';
    }

    statScore.textContent = score;
    statServed.textContent = served;
    statMissed.textContent = missed;
    statFailed.textContent = failed || 0;

    const m = Math.floor(Math.max(0, serviceRemaining) / 60).toString().padStart(2, '0');
    const s = Math.floor(Math.max(0, serviceRemaining) % 60).toString().padStart(2, '0');
    serviceTimeEl.textContent = `${m}:${s}`;
    serviceFillEl.style.width = Math.max(0, (serviceRemaining / totalServiceTime) * 100) + '%';
  }

  function renderMiniRail() {
    orderCountBadge.textContent = activeOrders.length;
    
    if (!activeOrders.length) {
      miniRail.innerHTML = `<div class="empty-rail-mini">No orders — start service to see them appear.</div>`;
      return;
    }
    
    miniRail.innerHTML = activeOrders.map((o, i) => {
      const tilt = (Math.random() * 3 - 1.5).toFixed(1) + 'deg';
      const statusClass = o.status || 'waiting';
      const statusLabel = statusClass.charAt(0).toUpperCase() + statusClass.slice(1);
      const timeLeft = o.remaining !== undefined ? Math.ceil(o.remaining) : '?';
      
      return `<div class="mini-ticket" style="--tilt:${tilt}">
        <span class="dish">${o.dish}</span>
        <span class="time">${timeLeft}s</span>
        <span class="status-badge-mini ${statusClass}">${statusLabel}</span>
      </div>`;
    }).join('');
  }

  // ----- Read params from UI -----
  function readParamsFromUI() {
    params.spawnMin = parseFloat(spawnMinInput.value);
    params.spawnMax = parseFloat(spawnMaxInput.value);
    params.prepTime = parseFloat(prepTimeInput.value);
    params.rampFactor = parseFloat(rampFactorInput.value);
    params.totalTime = parseFloat(totalTimeInput.value);
    
    spawnMinVal.textContent = params.spawnMin + 's';
    spawnMaxVal.textContent = params.spawnMax + 's';
    prepTimeVal.textContent = params.prepTime + 's';
    rampFactorVal.textContent = params.rampFactor.toFixed(2);
    
    const mins = Math.floor(params.totalTime / 60);
    const secs = Math.floor(params.totalTime % 60);
    totalTimeVal.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
  }

  spawnMinInput.addEventListener('input', readParamsFromUI);
  spawnMaxInput.addEventListener('input', readParamsFromUI);
  prepTimeInput.addEventListener('input', readParamsFromUI);
  rampFactorInput.addEventListener('input', readParamsFromUI);
  totalTimeInput.addEventListener('input', readParamsFromUI);

  // ----- Send params to game -----
  function sendParamsToGame() {
    readParamsFromUI();
    channel.postMessage({
      type: 'params',
      payload: { ...params }
    });
    totalServiceTime = params.totalTime;
    if (!running && serviceRemaining <= 0) {
      serviceRemaining = totalServiceTime;
    }
    updateUI();
    connectionStatus.textContent = '📤 Params sent!';
    connectionStatus.className = 'connection-status syncing';
    addLog('info', '📤 Parameters sent to game', params);
    setTimeout(() => {
      connectionStatus.textContent = '✅ Game connected';
      connectionStatus.className = 'connection-status connected';
    }, 2000);
  }

  sendParamsBtn.addEventListener('click', sendParamsToGame);

  // ----- Presets -----
  document.querySelectorAll('[data-preset]').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset;
      let min, max, prep, ramp, total;
      switch (preset) {
        case 'quick':    min=3; max=8; prep=15; ramp=0.95; total=120; break;
        case 'normal':   min=6; max=11; prep=22; ramp=0.92; total=300; break;
        case 'long':     min=8; max=15; prep=25; ramp=0.88; total=900; break;
        case 'marathon': min=10; max=20; prep=30; ramp=0.85; total=1800; break;
        case 'endurance': min=12; max=25; prep=35; ramp=0.80; total=3600; break;
        default: return;
      }
      spawnMinInput.value = min;
      spawnMaxInput.value = max;
      prepTimeInput.value = prep;
      rampFactorInput.value = ramp;
      totalTimeInput.value = total;
      readParamsFromUI();
      sendParamsToGame();
      addLog('info', `📋 Preset loaded: ${preset}`, { min, max, prep, ramp, total });
    });
  });

  // ----- Service controls -----
  function startService() {
    channel.postMessage({ type: 'start' });
    startBtn.disabled = true;
    addLog('info', '▶ Start command sent');
  }

  function togglePause() {
    channel.postMessage({ type: 'pause' });
  }

  async function resetService() {
    addLog('info', '⟳ Reset command sent');
    
    // First, clear the database orders
    try {
      const response = await fetch('/api/orders/clear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'reset' })
      });
      
      const data = await response.json();
      
      if (data.success) {
        addLog('💾 DB', `✅ Database cleared: ${data.orders_cleared} orders removed, tags reset`);
        connectionStatus.textContent = '🗑 Database cleared';
        connectionStatus.className = 'connection-status syncing';
        setTimeout(() => {
          connectionStatus.textContent = '✅ Game connected';
          connectionStatus.className = 'connection-status connected';
        }, 2000);
      } else {
        addLog('❌ Error', `Failed to clear database: ${data.message || 'Unknown error'}`);
      }
    } catch (err) {
      addLog('❌ Error', `Error clearing database: ${err.message}`);
    }
    
    // Then send reset command to game
    channel.postMessage({ type: 'reset' });
    
    // Clear local state
    running = false;
    paused = false;
    score = 0;
    served = 0;
    missed = 0;
    failed = 0;
    serviceRemaining = totalServiceTime;
    activeOrders = [];
    
    updateUI();
    renderMiniRail();
    
    // Update UI buttons
    startBtn.disabled = false;
    pauseBtn.disabled = true;
    pauseBtn.textContent = '⏸ Pause';
  }

  startBtn.addEventListener('click', startService);
  pauseBtn.addEventListener('click', togglePause);
  resetBtn.addEventListener('click', resetService);

  // ----- ESP Status Check -----
  async function checkESPStatus() {
    try {
      const response = await fetch('/api/esp/status');
      const data = await response.json();
      
      if (data.online) {
        espStatus.textContent = '✅ ESP Online';
        espStatus.className = 'esp-status-indicator online';
        addLog('info', '✅ ESP device is online');
      } else {
        espStatus.textContent = '⚠️ ESP Offline';
        espStatus.className = 'esp-status-indicator offline';
        addLog('info', '⚠️ No ESP devices online');
      }
      
      channel.postMessage({
        type: 'esp-status',
        payload: { online: data.online }
      });
      
    } catch (error) {
      espStatus.textContent = '❌ ESP Error';
      espStatus.className = 'esp-status-indicator offline';
      addLog('❌ Error', `ESP status check failed: ${error.message}`);
    }
  }

  document.getElementById('refreshEspBtn').addEventListener('click', checkESPStatus);

  // ----- Log controls -----
  document.getElementById('clearLogsBtn').addEventListener('click', () => {
    logsContainer.innerHTML = '';
    addLog('info', '🗑 Logs cleared');
  });

  document.getElementById('toggleLogsBtn').addEventListener('click', () => {
    autoScroll = !autoScroll;
    document.getElementById('toggleLogsBtn').textContent = autoScroll ? '⬇ Auto-scroll' : '⬆ Manual';
    addLog('info', autoScroll ? '⬇ Auto-scroll enabled' : '⬆ Auto-scroll disabled');
  });

  // ----- Request state from game on load -----
  setTimeout(() => {
    channel.postMessage({ type: 'state' });
    addLog('info', '🔄 Requesting game state...');
  }, 500);

  // Also request state every 5 seconds to keep sync
  setInterval(() => {
    channel.postMessage({ type: 'state' });
  }, 5000);

  // ----- Init -----
  readParamsFromUI();
  updateUI();
  renderMiniRail();

  // Send initial params
  setTimeout(() => {
    sendParamsToGame();
    checkESPStatus();
  }, 1000);

  // Refresh ESP status every 30 seconds
  setInterval(checkESPStatus, 30000);

  console.log('🎛 Ticket Rail Controller ready with extended controls and logging.');
  addLog('info', '🚀 Dashboard initialized');
</script>
</body>
</html>