<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title><%= title%></title>
    <style>
        body {
            background: radial-gradient(ellipse at top, #363c40 0%, #24282b 60%);
            font-family: 'Inter', sans-serif;
            color: #e9e6de;
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }
        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        h1 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 38px;
            letter-spacing: 2px;
            color: #f5f2ea;
            margin: 0 0 4px 0;
        }
        .subtitle {
            color: #6b6558;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .header-actions {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            align-items: center;
        }
        .header-actions button {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            color: white;
            cursor: pointer;
            font-size: 14px;
            transition: 0.15s;
            font-family: 'Inter', sans-serif;
        }
        .header-actions button:hover {
            transform: translateY(-2px);
        }
        .btn-refresh {
            background: #2196F3;
        }
        .btn-refresh:hover {
            background: #1976D2;
        }
        .btn-back {
            background: #666;
        }
        .btn-back:hover {
            background: #555;
        }
        .refresh-indicator {
            font-size: 12px;
            color: #6b6558;
            margin-left: auto;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .stat-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 16px 20px;
            text-align: center;
        }
        .stat-card .number {
            font-size: 32px;
            font-weight: 700;
            color: #f5f2ea;
        }
        .stat-card .label {
            font-size: 11px;
            color: #6b6558;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 4px;
        }
        .stat-card.online .number { color: #4a9d6e; }
        .stat-card.offline .number { color: #d9463c; }
        .stat-card.total .number { color: #f5f2ea; }
        .stat-card.taggers .number { color: #64b5f6; }
        .stat-card.counters .number { color: #ce93d8; }

        /* Device Table */
        .device-table-wrap {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
            overflow: hidden;
        }
        .device-table {
            width: 100%;
            border-collapse: collapse;
        }
        .device-table th {
            background: rgba(255,255,255,0.06);
            padding: 12px 16px;
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6b6558;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .device-table td {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 14px;
            color: #e9e6de;
        }
        .device-table tr:hover td {
            background: rgba(255,255,255,0.03);
        }
        .device-table tr:last-child td {
            border-bottom: none;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }
        .status-badge.online {
            background: rgba(74, 157, 110, 0.2);
            color: #4a9d6e;
        }
        .status-badge.offline {
            background: rgba(217, 70, 60, 0.2);
            color: #d9463c;
        }

        .type-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
        }
        .type-badge.tagger {
            background: rgba(33, 150, 243, 0.2);
            color: #64b5f6;
        }
        .type-badge.counter {
            background: rgba(156, 39, 176, 0.2);
            color: #ce93d8;
        }
        .type-badge.tag {
            background: rgba(255, 152, 0, 0.2);
            color: #ffb74d;
        }
        .type-badge.unassigned {
            background: rgba(255,255,255,0.05);
            color: #6b6558;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #6b6558;
            font-family: 'Courier Prime', monospace;
        }

        code {
            background: rgba(255,255,255,0.05);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 13px;
            color: #e9e6de;
        }

        @media (max-width: 768px) {
            .device-table {
                font-size: 12px;
            }
            .device-table th,
            .device-table td {
                padding: 8px 10px;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1 {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <h1>📡 ESP Device Dashboard</h1>
        <p class="subtitle">Real-time status of all connected ESP32 devices</p>

        <div class="header-actions">
            <button class="btn-refresh" onclick="refreshData()">🔄 Refresh</button>
            <button class="btn-back" onclick="window.location.href='/'">⬅ Back to Home</button>
            <span class="refresh-indicator" id="lastUpdate">Last updated: Just now</span>
        </div>

        <!-- Stats -->
        <div class="stats-grid" id="statsGrid">
            <div class="stat-card total">
                <div class="number" id="totalDevices">0</div>
                <div class="label">Total Devices</div>
            </div>
            <div class="stat-card online">
                <div class="number" id="onlineDevices">0</div>
                <div class="label">Online</div>
            </div>
            <div class="stat-card offline">
                <div class="number" id="offlineDevices">0</div>
                <div class="label">Offline</div>
            </div>
            <div class="stat-card taggers">
                <div class="number" id="taggerCount">0</div>
                <div class="label">Taggers</div>
            </div>
            <div class="stat-card counters">
                <div class="number" id="counterCount">0</div>
                <div class="label">Counters</div>
            </div>
        </div>

        <!-- Device Table -->
        <div class="device-table-wrap">
            <table class="device-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>MAC Address</th>
                        <th>Type</th>
                        <th>IP Address</th>
                        <th>Last Seen</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="deviceTableBody">
                    <tr>
                        <td colspan="6" class="empty-state">⏳ Loading devices...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        let autoRefreshInterval = null;

        async function refreshData() {
            try {
                // Fetch devices
                const response = await fetch('/api/esp/devices');
                const data = await response.json();
                
                if (data.success) {
                    renderDevices(data.devices);
                    updateStats(data.devices);
                    document.getElementById('lastUpdate').textContent = 'Last updated: ' + new Date().toLocaleTimeString();
                } else {
                    console.error('Error fetching devices:', data.error);
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('deviceTableBody').innerHTML = `
                    <tr>
                        <td colspan="6" class="empty-state">❌ Error loading devices. Please try again.</td>
                    </tr>
                `;
            }
        }

        function renderDevices(devices) {
            const tbody = document.getElementById('deviceTableBody');
            
            if (!devices || devices.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="empty-state">📭 No ESP32 devices registered yet.</td>
                    </tr>
                `;
                return;
            }

            const now = Date.now();
            const fiveMinutes = 5 * 60 * 1000;

            tbody.innerHTML = devices.map(device => {
                const lastSeen = device.last_seen ? new Date(device.last_seen) : null;
                const isOnline = lastSeen && (now - lastSeen.getTime()) < fiveMinutes;
                const statusClass = isOnline ? 'online' : 'offline';
                const statusText = isOnline ? '🟢 Online' : '🔴 Offline';
                
                const typeClass = device.device_type || 'unassigned';
                const typeLabel = device.device_type || 'Unassigned';

                return `
                    <tr>
                        <td>${device.esp32_id || device.device_id || 'N/A'}</td>
                        <td><code>${device.device_mac}</code></td>
                        <td><span class="type-badge ${typeClass}">${typeLabel}</span></td>
                        <td>${device.ip_address || 'N/A'}</td>
                        <td>${lastSeen ? lastSeen.toLocaleString() : 'Never'}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                    </tr>
                `;
            }).join('');
        }

        function updateStats(devices) {
            const now = Date.now();
            const fiveMinutes = 5 * 60 * 1000;
            
            const total = devices ? devices.length : 0;
            const online = devices ? devices.filter(d => {
                const lastSeen = d.last_seen ? new Date(d.last_seen) : null;
                return lastSeen && (now - lastSeen.getTime()) < fiveMinutes;
            }).length : 0;
            const offline = total - online;
            
            const taggers = devices ? devices.filter(d => d.device_type === 'tagger').length : 0;
            const counters = devices ? devices.filter(d => d.device_type === 'counter').length : 0;

            document.getElementById('totalDevices').textContent = total;
            document.getElementById('onlineDevices').textContent = online;
            document.getElementById('offlineDevices').textContent = offline;
            document.getElementById('taggerCount').textContent = taggers;
            document.getElementById('counterCount').textContent = counters;
        }

        // Auto-refresh every 10 seconds
        function startAutoRefresh() {
            refreshData();
            if (autoRefreshInterval) clearInterval(autoRefreshInterval);
            autoRefreshInterval = setInterval(refreshData, 10000);
        }

        // Stop auto-refresh when page is hidden
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                if (autoRefreshInterval) {
                    clearInterval(autoRefreshInterval);
                    autoRefreshInterval = null;
                }
            } else {
                startAutoRefresh();
            }
        });

        // Initial load
        startAutoRefresh();
    </script>
</body>
</html>