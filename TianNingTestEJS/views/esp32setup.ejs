<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"  type="text/css" href="/main.css" />
    <title><%= title%></title>
    <script src="/scripts/esp32setup.js"></script>
</head>
<body>
  <header>
    <!-- Requirement: Settings Page, to include ESP32 Checking and Recipe Management-->
    <h1>Welcome to ESP32 Setup</h1>
    <!-- Requirement: Redirect to <<ESP32 Here>> Section-->
    <button type="button">ESP32 Setup</button> <br>

    <table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>ID</th>
            <th>MAC Address</th>
            <th>IP Address</th>
            <th>Last Seen</th>
            <th>Device Type</th>
        </tr>
    </thead>

    <tbody>
        <% if (devices.length === 0) { %>
            <tr>
                <td colspan="4">No ESP32 devices detected yet.</td>
            </tr>
        <% } else { %>
            <% devices.forEach(device => { %>
                <tr>
                    <td><%= device.esp32_id %></td>
                    <td><%= device.device_mac %></td>
                    <td><%= device.ip_address %></td>
                    <td><%= device.last_seen %></td>
                    <td><%= device.device_type %> 
                    <button onClick ="updateESP32('<%= JSON.stringify(device) %>')"> Edit Device </button>
                    </td> 
                </tr>
            <% }) %>
        <% } %>
    </tbody>
</table>

<form action="/settings/esp32/send" method="POST">
    <label>ESP32 IP:</label>
    <input type="text" name="ip_address">
    <label>Message:</label>
    <input type="text" name="message">
    <button type="submit">Send</button>
</form>




</body>
</html>