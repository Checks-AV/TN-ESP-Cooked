<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title><%= title%></title>
    <script src="/scripts/esp32setup.js"></script>
</head>
<body>
  <header>
    <h1>Welcome to ESP32 Setup</h1>
    <button type="button" onclick="window.location.href='/settings'">Back to Settings</button> <br><br>

    <table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>ID</th>
            <th>MAC Address</th>
            <th>IP Address</th>
            <th>Last Seen</th>
            <th>Device Type</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        <% if (devices.length === 0) { %>
            <tr>
                <td colspan="6">No ESP32 devices detected yet.</td>
            </tr>
        <% } else { %>
            <% devices.forEach(device => { %>
                <tr>
                    <td><%= device.esp32_id %></td>
                    <td><%= device.device_mac %></td>
                    <td><%= device.ip_address || 'N/A' %></td>
                    <td><%= device.last_seen || 'Never' %></td>
                    <td><%= device.device_type || 'Unassigned' %></td>
                    <td>
                        <button onclick="openEditModal('<%= JSON.stringify(device).replace(/'/g, "\\'") %>')">Edit</button>
                    </td>
                </tr>
            <% }) %>
        <% } %>
    </tbody>
</table>

<!-- ─── REGISTER A NEW ESP32 ─────────────────────────── -->
<h2>Register New ESP32</h2>
<form action="/esp32comms/register" method="POST">
    <label>MAC Address:</label>
    <input type="text" name="device_mac" placeholder="AA:BB:CC:DD:EE:FF" required>

    <label>Device Type:</label>
    <select name="device_type">
        <option value="">-- unset --</option>
        <option value="tagger">Tagger (station scanner)</option>
        <option value="tag">Tag (ingredient)</option>
    </select>

    <label>IP Address:</label>
    <input type="text" name="ip_address" placeholder="192.168.1.x">

    <button type="submit">Register</button>
</form>

<hr>

<!-- ─── ASSIGN TAG → INGREDIENT ──────────────────────── -->
<h2>Assign Tag to Ingredient</h2>
<p>After registering a device as a <strong>tag</strong>, link it to an ingredient here.</p>
<form action="/esp32comms/assign-tag" method="POST">
    <label>Tag Device MAC:</label>
    <input type="text" name="device_mac" placeholder="AA:BB:CC:DD:EE:FF" required>

    <label>Ingredient:</label>
    <select name="ingredients_id" required>
        <% if (typeof ingredients !== 'undefined') { %>
            <% ingredients.forEach(i => { %>
                <option value="<%= i.ingredients_id %>"><%= i.ingredients_name %></option>
            <% }) %>
        <% } %>
    </select>

    <button type="submit">Assign</button>
</form>

<hr>

<!-- ─── ASSIGN TAGGER → STATION ──────────────────────── -->
<h2>Assign Tagger to Station</h2>
<p>Link a <strong>tagger</strong> device to a cooking station.</p>
<form action="/esp32comms/assign-tagger" method="POST">
    <label>Tagger Device MAC:</label>
    <input type="text" name="device_mac" placeholder="AA:BB:CC:DD:EE:FF" required>

    <label>Station:</label>
    <select name="station_id" required>
        <% if (typeof stations !== 'undefined') { %>
            <% stations.forEach(s => { %>
                <option value="<%= s.station_id %>"><%= s.station_name %></option>
            <% }) %>
        <% } %>
    </select>

    <button type="submit">Assign</button>
</form>

<form action="/esp32comms/esp32/send" method="POST">
    <label>ESP32 IP:</label>
    <input type="text" name="ip_address">
    <label>Message:</label>
    <input type="text" name="message">
    <button type="submit">Send</button>
</form>

<!-- ─── EDIT MODAL ────────────────────────────────────── -->
<div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:30px; border-radius:8px; max-width:500px; width:90%; max-height:90vh; overflow-y:auto;">
        <h2>Edit ESP32 Device</h2>
        <form id="editForm" action="/esp32comms/update" method="POST">
            <input type="hidden" id="editDeviceId" name="esp32_id">
            
            <div style="margin-bottom:15px;">
                <label style="display:block; margin-bottom:5px;">MAC Address:</label>
                <input type="text" id="editMac" name="device_mac" required style="width:100%; padding:8px; box-sizing:border-box;">
            </div>

            <div style="margin-bottom:15px;">
                <label style="display:block; margin-bottom:5px;">IP Address:</label>
                <input type="text" id="editIp" name="ip_address" style="width:100%; padding:8px; box-sizing:border-box;">
            </div>

            <div style="margin-bottom:15px;">
                <label style="display:block; margin-bottom:5px;">Device Type:</label>
                <select id="editType" name="device_type" style="width:100%; padding:8px; box-sizing:border-box;">
                    <option value="">-- unset --</option>
                    <option value="tagger">Tagger (station scanner)</option>
                    <option value="tag">Tag (ingredient)</option>
                </select>
            </div>

            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" style="flex:1; padding:10px; background:#4CAF50; color:white; border:none; border-radius:4px; cursor:pointer;">Save Changes</button>
                <button type="button" onclick="closeEditModal()" style="flex:1; padding:10px; background:#f44336; color:white; border:none; border-radius:4px; cursor:pointer;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal background click to close -->
<script>
// Close modal when clicking outside
document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeEditModal();
    }
});
</script>

</body>
</html>