<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title><%= title%></title>
</head>
<body>
  <header>
    <h1>Welcome to ESP32 Setup</h1>
    <button type="button" onclick="window.location.href='/settings'">Back to Settings</button> <br><br>

    <!-- ─── DEVICE LIST TABLE ─────────────────────────────── -->
    <h2>Registered ESP32 Devices</h2>
    <table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>ID</th>
            <th>MAC Address</th>
            <th>IP Address</th>
            <th>Last Seen</th>
            <th>Station Type</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        <% if (devices.length === 0) { %>
            <tr>
                <td colspan="6">No ESP32 devices detected yet.</td>
            </tr>
        <% } else { %>
            <% devices.forEach(device => { %>
                <tr>
                    <td><%= device.device_id %></td>
                    <td><%= device.device_mac %></td>
                    <td><%= device.ip_address || 'N/A' %></td>
                    <td><%= device.last_seen || 'Never' %></td>
                    <td><%= device.station_name || 'Unassigned' %></td>
                    <td>
                        <button type="button" onclick='openEditModal(<%- JSON.stringify(device) %>)'>Edit</button>
                        <button type="button" onclick="deleteDevice('<%= device.device_id %>', '<%= device.device_mac %>')" style="background:#f44336; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer; margin-left:5px;">Delete</button>
                    </td>
                </tr>
            <% }) %>
        <% } %>
    </tbody>
</table>

<hr>

<!-- ─── REGISTER A NEW ESP32 ─────────────────────────── -->
<h2>Register New ESP32</h2>

<p>
    Register an ESP32 scanner and assign it to a station.
</p>

<form action="/settings/esp32/register" method="POST">

    <label>MAC Address:</label>
    <input
        type="text"
        name="device_mac"
        placeholder="AA:BB:CC:DD:EE:FF"
        required
    >

    <label>Station:</label>
    <select name="station_id" required>
        <option value="">-- Select Station --</option>
        <% stations.forEach(station => { %>
            <option value="<%= station.station_id %>">
                <%= station.station_name %>
            </option>
        <% }) %>
    </select>

    <label>IP Address:</label>
    <input
        type="text"
        name="ip_address"
        placeholder="192.168.1.x"
    >

    <button type="submit">
        Register
    </button>

</form>

<hr>

<!-- ─── ASSIGN TAG → INGREDIENT ──────────────────────── -->
<h2>Assign Tag to Ingredient</h2>
<p>Link a <strong>passive tag</strong> (RFID/NFC chip) to an ingredient. Tags are read by tagger devices.</p>
<form action="/settings/esp32/assign-tag" method="POST">
    <label>RFID Tag:</label>

    <input
        type="text"
        name="tag_rfid"
        placeholder="RFID UID"
        required
    >

    <label>Ingredient:</label>

    <select name="ingredients_id" required>
        <% ingredients.forEach(ingredient => { %>
            <option value="<%= ingredient.ingredients_id %>">
                <%= ingredient.ingredients_name %>
            </option>
        <% }) %>
    </select>

    <button type="submit">Assign</button>
</form>

<hr>

<!-- ─── TAG ASSIGNMENTS TABLE ─────────────────────────── -->
<h2>Tag → Ingredient Assignments</h2>
<p>Current tag assignments showing which tag is linked to which ingredient and its current status.</p>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>Assignment ID</th>
            <th>Tag MAC</th>
            <th>Ingredient</th>
            <th>Current Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% if (typeof tagAssignments !== 'undefined' && tagAssignments.length > 0) { %>
            <% tagAssignments.forEach(assignment => { %>
                <tr>
                    <td><%= assignment.tag_id %></td>
                    <td><%= assignment.tag_rfid %></td>
                    <td><%= assignment.ingredients_name %></td>
                    <td><%= assignment.current_status || 'Default' %></td>
                    <td>
                        <button onclick="editTagAssignment('<%= assignment.tag_id %>', '<%= assignment.tag_rfid %>', '<%= assignment.ingredients_id %>')">Edit</button>
                        <button onclick="deleteTagAssignment('<%= assignment.tag_id %>')" style="background:#f44336; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer;">Delete</button>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="5">No tag assignments found. Please assign tags to ingredients.</td>
            </tr>
        <% } %>
    </tbody>
</table>

<hr>

<!-- ─── RESET TAG STATUS ────────────────────────────────────── -->
<h2>Reset Tag Status</h2>
<p>Manually reset a single tag's status back to 'Default'. This is useful for clearing a tag that's stuck in a specific status.</p>

<form id="resetTagForm">
    <label>RFID Tag:</label>
    <input
        type="text"
        id="resetTagRfid"
        name="tag_rfid"
        placeholder="RFID UID"
        required
        style="padding:8px; width:200px; margin-right:10px;"
    >
    <button type="submit" style="padding:8px 16px; background:#ff9800; color:white; border:none; border-radius:4px; cursor:pointer;">
        Reset Tag
    </button>
</form>

<hr>

<!-- ─── EDIT ASSIGNMENT MODAL ─────────────────────────── -->
<div id="editAssignmentModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:30px; border-radius:8px; max-width:500px; width:90%; max-height:90vh; overflow-y:auto;">
        <h2>Edit Tag Assignment</h2>
        <form id="editAssignmentForm" action="/settings/esp32/update-tag-assignment" method="POST">
            <input type="hidden" id="editAssignmentId" name="tag_id">
            
            <div style="margin-bottom:15px;">
                <label style="display:block; margin-bottom:5px;">Tag MAC Address:</label>
                <input type="text" id="editAssignmentMac" name="tag_rfid" required style="width:100%; padding:8px; box-sizing:border-box;">
            </div>

            <div style="margin-bottom:15px;">
                <label style="display:block; margin-bottom:5px;">Ingredient:</label>
                <select id="editAssignmentIngredient" name="ingredients_id" required style="width:100%; padding:8px; box-sizing:border-box;">
                    <% if (typeof ingredients !== 'undefined') { %>
                        <% ingredients.forEach(i => { %>
                            <option value="<%= i.ingredients_id %>"><%= i.ingredients_name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" style="flex:1; padding:10px; background:#4CAF50; color:white; border:none; border-radius:4px; cursor:pointer;">Save Changes</button>
                <button type="button" onclick="closeEditAssignmentModal()" style="flex:1; padding:10px; background:#f44336; color:white; border:none; border-radius:4px; cursor:pointer;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- ─── EDIT DEVICE MODAL ─────────────────────────────── -->
<div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">

<div style="position:absolute; top:50%; left:50%;
            transform:translate(-50%,-50%);
            background:white; padding:30px; border-radius:8px;
            max-width:500px; width:90%; max-height:90vh;
            overflow-y:auto;">

    <h2>Edit ESP32 Device</h2>

    <form id="editForm"
          action="/settings/esp32/update"
          method="POST">

        <!-- Must match req.body.device_id -->
        <input
            type="hidden"
            id="editDeviceId"
            name="device_id"
        >

        <div style="margin-bottom:15px;">
            <label style="display:block; margin-bottom:5px;">
                MAC Address:
            </label>

            <input
                type="text"
                id="editMac"
                name="device_mac"
                required
                style="width:100%; padding:8px; box-sizing:border-box;"
            >
        </div>

        <div style="margin-bottom:15px;">
            <label style="display:block; margin-bottom:5px;">
                IP Address:
            </label>

            <input
                type="text"
                id="editIp"
                name="ip_address"
                style="width:100%; padding:8px; box-sizing:border-box;"
            >
        </div>

        <div style="margin-bottom:15px;">
            <label style="display:block; margin-bottom:5px;">
                Station:
            </label>

            <select
                id="editStation"
                name="station_id"
                required
                style="width:100%; padding:8px; box-sizing:border-box;"
            >
                <option value="">
                    -- Select Station --
                </option>

                <% stations.forEach(station => { %>
                    <option value="<%= station.station_id %>">
                        <%= station.station_name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div style="display:flex; gap:10px; margin-top:20px;">
            <button
                type="submit"
                style="flex:1; padding:10px; background:#4CAF50;
                       color:white; border:none; border-radius:4px;
                       cursor:pointer;"
            >
                Save Changes
            </button>

            <button
                type="button"
                onclick="closeEditModal()"
                style="flex:1; padding:10px; background:#f44336;
                       color:white; border:none; border-radius:4px;
                       cursor:pointer;"
            >
                Cancel
            </button>
        </div>
    </form>
</div>

</div>

<!-- ─── JAVASCRIPT ─────────────────────────────────────── -->
<script>
// ─── MODAL FUNCTIONS ──────────────────────────────────────────

function openEditModal(device) {
    document.getElementById("editDeviceId").value =
        device.device_id;

    document.getElementById("editMac").value =
        device.device_mac;

    document.getElementById("editIp").value =
        device.ip_address || "";

    document.getElementById("editStation").value =
        device.station_id || "";

    document.getElementById("editModal").style.display =
        "block";
}

function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
}

function closeEditAssignmentModal() {
    document.getElementById('editAssignmentModal').style.display = 'none';
}

// Close modals when clicking outside
document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeEditModal();
    }
});

document.getElementById('editAssignmentModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeEditAssignmentModal();
    }
});

// ─── EDIT TAG ASSIGNMENT ──────────────────────────────────────

function editTagAssignment(tag_id, tag_rfid, ingredients_id) {
    document.getElementById('editAssignmentId').value = tag_id;
    document.getElementById('editAssignmentMac').value = tag_rfid;
    document.getElementById('editAssignmentIngredient').value = ingredients_id;
    document.getElementById('editAssignmentModal').style.display = 'block';
}

// ─── DELETE TAG ASSIGNMENT ────────────────────────────────────

function deleteTagAssignment(tag_id) {
    if (confirm('Are you sure you want to delete this tag assignment?')) {
        fetch('/settings/esp32/delete-tag-assignment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ tag_id: tag_id })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Assignment deleted successfully!');
                window.location.reload();
            } else {
                alert('Error: ' + data.error);
            }
        })
        .catch(error => {
            alert('Error deleting assignment: ' + error);
        });
    }
}

// ─── RESET TAG ──────────────────────────────────────────────────

document.getElementById('resetTagForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const tag_rfid = document.getElementById('resetTagRfid').value.trim();
    
    if (!tag_rfid) {
        alert('Please enter a tag RFID.');
        return;
    }
    
    // Confirm the reset action
    if (!confirm(`Are you sure you want to reset tag ${tag_rfid} to 'Default'?`)) {
        return;
    }
    
    fetch('/settings/esp32/reset-tag', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ tag_rfid })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(`Tag ${data.tag_rfid} reset successfully!\nPrevious status: ${data.previous_status}\nNew status: ${data.new_status}`);
            window.location.reload();
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(error => {
        alert('Error resetting tag: ' + error);
    });
});

// ─── DELETE DEVICE ─────────────────────────────────────────────

function deleteDevice(deviceId, deviceMac) {
    if (!confirm(`Are you sure you want to permanently remove device ${deviceMac}?\n\nThis action cannot be undone.`)) {
        return;
    }
    
    fetch(`/settings/esp32/device/${deviceId}`, {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Device removed successfully!');
            window.location.reload();
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(error => {
        alert('Error removing device: ' + error);
    });
}

// ─── CLOSE MODALS ON ESC ──────────────────────────────────────

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeEditModal();
        closeEditAssignmentModal();
    }
});
</script>

</body>
</html>