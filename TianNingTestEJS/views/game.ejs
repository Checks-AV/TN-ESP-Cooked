<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Overcooked — Ticket Rail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@600;700;800;900&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
  
  <style>
    /* ============================================================
       KITCHEN PALETTE & BASE STYLES
       ============================================================ */
    :root {
      --teal-deep:  #0a4443;
      --teal-mid:   #0f6564;
      --teal-glow:  #1a8f8c;
      --teal-pale:  #eaf7f6;
      --teal-pale2: #d3ede9;
      --flame:      #ff7a3d;
      --flame-dark: #e05a1f;
      --tomato:     #ef4444;
      --tomato-dark:#b8281f;
      --butter:     #ffc94d;
      --butter-dark:#d99a12;
      --herb:       #4fbf5f;
      --herb-dark:  #2c8a3a;
      --paper:      #fff6e2;
      --paper-dim:  #ffe9bd;
      --wood:       #9a6738;
      --wood-dark:  #603c1e;
      --ink:        #241609;
      --ink-soft:   #6b5641;
      --line-soft:  rgba(255,255,255,0.14);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'Nunito', sans-serif;
      color: var(--ink);
      padding-bottom: 40px;
      overflow-x: hidden;
      position: relative;
      background:
        radial-gradient(circle at 15% -10%, rgba(255,201,77,0.22), transparent 45%),
        radial-gradient(circle at 90% 10%, rgba(255,122,61,0.16), transparent 40%),
        repeating-linear-gradient(45deg, rgba(255,255,255,0.35) 0 2px, transparent 2px 28px),
        linear-gradient(180deg, var(--teal-pale), var(--teal-pale2) 55%, #bfe4df 100%);
    }

    ::selection { background: var(--butter); color: var(--ink); }

    /* ============================================================
       HEADER
       ============================================================ */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 32px;
      background: linear-gradient(180deg, var(--wood), var(--wood-dark));
      border-bottom: 5px solid var(--ink);
      box-shadow: 0 4px 0 rgba(0,0,0,0.12), 0 6px 14px rgba(0,0,0,0.15);
      flex-wrap: wrap;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .brand { display: flex; align-items: center; gap: 14px; }
    .brand .chef-badge {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--butter);
      border: 3px solid var(--ink);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 3px 3px 0 rgba(0,0,0,0.35);
      animation: bounce 2.2s infinite ease-in-out;
      flex-shrink: 0;
    }
    .brand .chef-badge svg { width: 24px; height: 24px; color: var(--ink); }
    @keyframes bounce {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-5px) rotate(-4deg); }
    }
    .brand h1 {
      font-family: 'Baloo 2', cursive;
      font-weight: 800;
      font-size: 30px;
      margin: 0;
      color: var(--paper);
      text-shadow: 3px 3px 0 var(--ink);
      letter-spacing: 0.5px;
    }
    .brand .sub {
      font-size: 11px;
      letter-spacing: 1.5px;
      color: var(--ink);
      text-transform: uppercase;
      font-weight: 800;
      background: var(--flame);
      border: 2px solid var(--ink);
      padding: 3px 10px;
      border-radius: 20px;
      margin-left: 6px;
      box-shadow: 2px 2px 0 rgba(0,0,0,0.3);
    }

    .header-controls { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    .icon { display: inline-flex; width: 14px; height: 14px; flex-shrink: 0; }
    .icon svg { width: 100%; height: 100%; display: block; }

    /* ============================================================
       STATUS PILL
       ============================================================ */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 16px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: var(--paper);
      color: var(--ink);
      border: 3px solid var(--ink);
      box-shadow: 3px 3px 0 rgba(0,0,0,0.3);
      transition: all 0.2s;
    }
    .status-pill.running { background: var(--herb); animation: pulse-green 1.6s infinite; }
    .status-pill.paused  { background: var(--butter); }
    .status-pill.idle    { background: var(--paper); color: var(--ink-soft); }
    .status-pill.ended   { background: var(--tomato); color: #fff; }
    .status-pill.peak    { background: var(--tomato); color: #fff; animation: pulse-red 0.9s infinite; }
    .status-pill.manual-peak { background: var(--tomato-dark); color: #fff; animation: pulse-red 0.5s infinite; }
    @keyframes pulse-green {
      0%, 100% { box-shadow: 3px 3px 0 rgba(0,0,0,0.3); }
      50% { box-shadow: 3px 3px 0 rgba(0,0,0,0.3), 0 0 18px 3px rgba(79,191,95,0.5); }
    }
    @keyframes pulse-red {
      0%, 100% { box-shadow: 3px 3px 0 rgba(0,0,0,0.3); }
      50% { box-shadow: 3px 3px 0 rgba(0,0,0,0.3), 0 0 18px 3px rgba(239,68,68,0.6); }
    }

    /* ============================================================
       SERVICE BAR
       ============================================================ */
    .service-bar-wrap { padding: 20px 32px 12px; }
    .service-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'Nunito', sans-serif;
      font-size: 12px;
      font-weight: 800;
      color: rgba(36,22,9,0.65);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    .service-row .icon { width: 12px; height: 12px; margin-right: 5px; vertical-align: -1px; }
    .service-time {
      font-family: 'Baloo 2', cursive;
      font-weight: 800;
      font-size: 30px;
      color: var(--butter-dark);
      letter-spacing: 1px;
      text-shadow: 2px 2px 0 rgba(255,255,255,0.6);
    }
    .service-track {
      height: 16px;
      background: rgba(0,0,0,0.15);
      border-radius: 8px;
      overflow: hidden;
      border: 3px solid var(--ink);
    }
    .service-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, var(--herb), var(--butter) 55%, var(--tomato));
      transition: width 0.8s linear;
    }
    .service-fill.peak {
      background: repeating-linear-gradient(45deg, var(--tomato), var(--tomato) 10px, var(--flame) 10px, var(--flame) 20px);
    }

    /* ============================================================
       STATS
       ============================================================ */
    .stat-strip {
      display: flex;
      padding: 14px 32px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .stat {
      flex: 1;
      min-width: 110px;
      padding: 10px 14px;
      background: var(--paper);
      border: 3px solid var(--ink);
      border-radius: 12px;
      box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
      text-align: center;
    }
    .stat .num {
      font-family: 'Baloo 2', cursive;
      font-weight: 800;
      font-size: 32px;
      letter-spacing: 0.5px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      color: var(--ink);
    }
    .stat .num .icon { width: 20px; height: 20px; }
    .stat .num.gold .icon, .stat .num.gold { color: var(--butter-dark); }
    .stat .num.green .icon, .stat .num.green { color: var(--herb-dark); }
    .stat .num.red .icon, .stat .num.red { color: var(--tomato-dark); }
    .stat .label {
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--ink-soft);
      font-weight: 800;
      margin-top: 4px;
      display: block;
    }

    /* ============================================================
       RAIL
       ============================================================ */
    .rail-wrap { position: relative; padding: 40px 32px 20px; }
    .rail-bar {
      position: absolute;
      top: 30px;
      left: 32px;
      right: 32px;
      height: 12px;
      background: linear-gradient(180deg, var(--wood), var(--wood-dark));
      border: 3px solid var(--ink);
      border-radius: 6px;
      box-shadow: 0 5px 14px rgba(0,0,0,0.25);
    }
    .rail-bar::before, .rail-bar::after {
      content: '';
      position: absolute;
      top: -8px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #cfcfcf, #6b6b6b);
      border: 3px solid var(--ink);
    }
    .rail-bar::before { left: -12px; }
    .rail-bar::after { right: -12px; }

    .rail {
      display: flex;
      flex-wrap: wrap;
      gap: 26px;
      padding: 12px 4px 30px;
      min-height: 250px;
      align-items: flex-start;
    }

    /* ============================================================
       EMPTY RAIL STATE
       ============================================================ */
    .empty-rail {
      color: rgba(36,22,9,0.85);
      padding: 50px 10px;
      text-align: center;
      width: 100%;
      font-size: 14px;
    }
    .empty-rail .glyph {
      width: 64px; height: 64px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background: var(--paper);
      border: 3px solid var(--ink);
      box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
      display: flex; align-items: center; justify-content: center;
      color: var(--ink);
    }
    .empty-rail .glyph svg { width: 30px; height: 30px; }
    .empty-rail .title { font-size: 21px; font-weight: 800; font-family: 'Baloo 2', cursive; color: var(--ink); text-shadow: 2px 2px 0 rgba(255,255,255,0.5); }
    .empty-rail .sub { font-size: 13.5px; color: rgba(36,22,9,0.6); margin-top: 6px; max-width: 480px; margin-left: auto; margin-right: auto; }
    .empty-rail.error .glyph { background: var(--tomato); color: #fff; }
    .empty-rail.error .title { color: var(--tomato-dark); text-shadow: none; }
    .empty-rail.loading .glyph { background: var(--butter); }
    .empty-rail.success .glyph { background: var(--herb); color: #fff; }
    .empty-rail .retry-btn {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--paper);
      border: 3px solid var(--ink);
      color: var(--ink);
      padding: 10px 24px;
      border-radius: 30px;
      cursor: pointer;
      margin-top: 18px;
      font-family: 'Nunito', sans-serif;
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
      transition: transform 0.12s, box-shadow 0.12s;
    }
    .empty-rail .retry-btn .icon { width: 13px; height: 13px; }
    .empty-rail .retry-btn:hover { transform: translate(-2px,-2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.3); }

    /* ============================================================
       TICKET
       ============================================================ */
    .ticket {
      flex: 0 0 280px;
      position: relative;
      padding-top: 20px;
      animation: dropIn 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.2);
      transition: opacity 0.3s, transform 0.3s;
    }
    @keyframes dropIn {
      from { transform: translateY(-30px) rotate(-4deg) scale(0.95); opacity: 0; }
      to { transform: translateY(0) rotate(var(--tilt)) scale(1); opacity: 1; }
    }
    @keyframes shake {
      0%,100% { transform: translateY(0) rotate(var(--tilt)); }
      20% { transform: translateX(-8px) rotate(var(--tilt)); }
      40% { transform: translateX(8px) rotate(var(--tilt)); }
      60% { transform: translateX(-5px) rotate(var(--tilt)); }
      80% { transform: translateX(5px) rotate(var(--tilt)); }
    }
    .ticket.missed .ticket-body { animation: shake 0.4s; filter: saturate(0.6); }
    /* FIX: preserve the ticket's rotate(var(--tilt)) tilt instead of clobbering it with a bare scale() */
    .ticket.completed .ticket-body { filter: saturate(0.6); opacity: 0.75; transform: rotate(var(--tilt)) scale(0.98); }
    .ticket.failed .ticket-body { filter: saturate(0.6); opacity: 0.55; transform: rotate(var(--tilt)) scale(0.95); }

    .clip {
      position: absolute;
      top: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 38px;
      height: 20px;
      background: linear-gradient(180deg, var(--wood), var(--wood-dark));
      border: 3px solid var(--ink);
      border-radius: 5px 5px 0 0;
      z-index: 2;
    }
    .clip::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 55%;
      width: 8px;
      height: 8px;
      background: var(--ink);
      border-radius: 50%;
      transform: translate(-50%, -50%);
    }

    .ticket-body {
      background: var(--paper);
      color: var(--ink);
      border-radius: 12px;
      border: 3px solid var(--ink);
      box-shadow: 6px 6px 0 rgba(0,0,0,0.25);
      transform: rotate(var(--tilt));
      position: relative;
      overflow: hidden;
    }

    .ticket-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 14px 16px 8px;
      border-bottom: 3px dashed var(--paper-dim);
      font-family: 'Baloo 2', cursive;
    }
    .order-no { font-size: 26px; font-weight: 800; line-height: 1; color: var(--ink); }
    .order-no .hash { color: var(--ink-soft); font-size: 13px; font-family: 'Nunito', sans-serif; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 2px; }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 5px 12px;
      border-radius: 30px;
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      white-space: nowrap;
      border: 2px solid var(--ink);
    }
    .status-badge .icon { width: 11px; height: 11px; }
    .status-badge.cooking { background: var(--flame); color: #fff; }
    .status-badge.late { background: var(--tomato); color: #fff; animation: blink 0.8s infinite; }
    .status-badge.missed { background: #9a9a9a; color: #fff; }
    .status-badge.completed { background: var(--herb); color: #fff; }
    .status-badge.waiting { background: var(--butter); color: var(--ink); }
    .status-badge.failed { background: var(--tomato-dark); color: #fff; }
    .status-badge.validating { background: var(--teal-glow); color: #fff; }
    @keyframes blink { 50% { opacity: 0.45; } }

    .dish-name {
      padding: 10px 16px 2px;
      font-size: 19px;
      font-weight: 800;
      line-height: 1.2;
      color: var(--ink);
      font-family: 'Baloo 2', cursive;
    }
    .points-tag {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      color: var(--herb-dark);
      font-weight: 800;
      padding: 4px 16px 6px;
    }
    .points-tag .icon { width: 13px; height: 13px; color: var(--butter-dark); }

    .ingredient-list { padding: 6px 16px 10px; }
    .ingredient-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12.5px;
      color: var(--ink-soft);
      padding: 4px 0;
      border-bottom: 1px dashed rgba(36,22,9,0.12);
      font-family: 'Courier Prime', monospace;
    }
    .ingredient-item:last-child { border-bottom: none; }
    .ingredient-item .name { font-weight: 700; color: var(--ink); }
    .ingredient-item .steps {
      font-size: 10px;
      color: var(--ink-soft);
      background: rgba(36,22,9,0.07);
      padding: 2px 12px;
      border-radius: 20px;
      font-weight: 700;
      font-family: 'Nunito', sans-serif;
      text-transform: uppercase;
    }
    .ingredient-item .status-dot {
      display: inline-block;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      margin-right: 8px;
      border: 2px solid var(--ink);
      transition: all 0.3s;
    }
    .status-dot.pending { background: var(--butter); }
    .status-dot.done { background: var(--herb); }
    .status-dot.failed { background: var(--tomato); }

    .timer-zone { padding: 6px 16px 14px; background: rgba(36,22,9,0.035); }
    .timer-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      margin-bottom: 6px;
      font-weight: 800;
      color: var(--ink);
      font-family: 'Nunito', sans-serif;
    }
    .timer-row .label { display: flex; align-items: center; gap: 5px; text-transform: uppercase; letter-spacing: 0.5px; font-size: 10.5px; color: var(--ink-soft); }
    .timer-row .label .icon { width: 12px; height: 12px; }
    .timer-row .time-left {
      font-family: 'Baloo 2', cursive;
      font-size: 15px;
      font-weight: 800;
      color: var(--tomato-dark);
    }
    .heat-gauge {
      height: 10px;
      width: 100%;
      background: rgba(36,22,9,0.12);
      border-radius: 6px;
      overflow: hidden;
      border: 2px solid var(--ink);
    }
    .heat-fill {
      height: 100%;
      width: 100%;
      background: var(--herb);
      transition: width 1s linear, background 0.4s;
    }

    .ticket-foot {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border-top: 3px dashed var(--paper-dim);
      padding: 9px 16px;
      font-size: 11.5px;
      color: var(--ink-soft);
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .ticket-foot .icon { width: 12px; height: 12px; }
    .ticket-foot .status-text.waiting { color: var(--butter-dark); }
    .ticket-foot .status-text.completed { color: var(--herb-dark); }
    .ticket-foot .status-text.missed { color: var(--tomato-dark); }
    .ticket-foot .status-text.failed { color: var(--tomato-dark); }
    .ticket-foot .status-text.validating { color: var(--teal-glow); }

    /* ============================================================
       TOAST
       ============================================================ */
    .toast {
      position: fixed;
      top: 100px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Baloo 2', cursive;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.5px;
      padding: 14px 30px;
      border-radius: 16px;
      z-index: 60;
      opacity: 0;
      pointer-events: none;
      border: 4px solid var(--ink);
      box-shadow: 6px 6px 0 rgba(0,0,0,0.4);
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .toast .icon { width: 22px; height: 22px; }
    .toast.show { animation: toastPop 1.2s cubic-bezier(0.2, 0.9, 0.3, 1.2) forwards; }
    @keyframes toastPop {
      0% { opacity: 0; transform: translate(-50%, 20px) scale(0.8); }
      15% { opacity: 1; transform: translate(-50%, 0) scale(1.06); }
      25% { transform: translate(-50%, 0) scale(1); }
      80% { opacity: 1; transform: translate(-50%, 0) scale(1); }
      100% { opacity: 0; transform: translate(-50%, -30px) scale(0.95); }
    }
    .toast.good { background: var(--herb); color: #fff; }
    .toast.bad { background: var(--tomato); color: #fff; }
    .toast.info { background: var(--teal-glow); color: #fff; }
    .toast.peak { background: var(--tomato-dark); color: #fff; }
    .toast.manual-peak { background: var(--tomato-dark); color: #fff; animation: toastPop 1.2s cubic-bezier(0.2, 0.9, 0.3, 1.2) forwards, pulse-red 0.5s 3; }

    /* ============================================================
       OVERLAY
       ============================================================ */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(5,20,20,0.82);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 20px;
      backdrop-filter: blur(4px);
    }
    .overlay.show { display: flex; animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .overlay-card {
      background: var(--paper);
      color: var(--ink);
      border-radius: 20px;
      padding: 40px 44px;
      text-align: center;
      max-width: 420px;
      width: 100%;
      border: 5px solid var(--ink);
      box-shadow: 8px 8px 0 rgba(0,0,0,0.4);
      animation: popIn 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2);
    }
    .overlay-card .plate-badge {
      width: 64px; height: 64px;
      border-radius: 50%;
      background: var(--butter);
      border: 3px solid var(--ink);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 10px;
      box-shadow: 3px 3px 0 rgba(0,0,0,0.3);
    }
    .overlay-card .plate-badge svg { width: 32px; height: 32px; color: var(--ink); }
    .overlay-card h2 {
      font-family: 'Baloo 2', cursive;
      font-size: 32px;
      font-weight: 800;
      letter-spacing: 0.5px;
      margin: 0 0 4px;
      color: var(--ink);
    }
    .stars { display: flex; justify-content: center; gap: 8px; margin: 12px 0 20px; }
    .stars .icon { width: 34px; height: 34px; color: var(--paper-dim); }
    .stars .icon.filled { color: var(--butter-dark); }
    .overlay-stats {
      font-family: 'Courier Prime', monospace;
      font-size: 14px;
      text-align: left;
      line-height: 2.4;
      color: var(--ink-soft);
      margin-bottom: 16px;
      background: rgba(36,22,9,0.05);
      padding: 16px 24px;
      border-radius: 12px;
      border: 2px solid rgba(36,22,9,0.1);
    }
    .overlay-stats b { float: right; color: var(--ink); font-size: 16px; }

    /* ============================================================
       NAME INPUT
       ============================================================ */
    .name-input-group {
      margin: 12px 0 12px;
      padding: 16px;
      background: rgba(36,22,9,0.04);
      border-radius: 12px;
      border: 2px solid rgba(36,22,9,0.08);
    }
    .name-input-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: var(--ink-soft);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
      text-align: left;
    }
    .name-input-group .input-row {
      display: flex;
      gap: 10px;
      margin-bottom: 6px;
    }
    .name-input-group input {
      flex: 1;
      padding: 12px 16px;
      border: 3px solid var(--ink);
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-size: 14px;
      font-weight: 700;
      background: var(--paper);
      color: var(--ink);
      outline: none;
      transition: border-color 0.2s;
    }
    .name-input-group input:focus {
      border-color: var(--teal-glow);
      box-shadow: 0 0 0 4px rgba(26,143,140,0.15);
    }
    .name-input-group .hint {
      font-size: 11px;
      color: var(--ink-soft);
      text-align: left;
    }

    .chef-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--butter);
      border: 3px solid var(--ink);
      color: var(--ink);
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 20px;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 4px 4px 0 rgba(0,0,0,0.3);
      transition: all 0.15s;
    }
    .chef-btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 rgba(0,0,0,0.3); }
    .chef-btn:active { transform: translate(0, 0); box-shadow: 2px 2px 0 rgba(0,0,0,0.3); }
    .chef-btn.start { background: var(--herb); color: #fff; }
    .chef-btn.start:hover { background: var(--herb-dark); }
    .chef-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }
    .chef-btn.saved { background: var(--herb); color: #fff; }

    .status-msg {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 12px;
      color: rgba(36,22,9,0.55);
      padding: 10px 20px;
      text-align: center;
    }
    .status-msg .icon { width: 12px; height: 12px; }
    .status-msg.error { color: var(--tomato-dark); }
    .status-msg.success { color: var(--herb-dark); }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @media (max-width: 640px) {
      header { flex-direction: column; align-items: stretch; padding: 12px 16px; }
      .brand { justify-content: center; }
      .brand h1 { font-size: 24px; }
      .header-controls { justify-content: center; flex-wrap: wrap; gap: 8px; }
      .stat { flex: 1 1 40%; }
      .stat-strip { padding: 10px 12px; }
      .ticket { flex: 0 0 240px; }
      .rail-wrap { padding: 32px 12px 12px; }
      .rail-bar { left: 12px; right: 12px; }
      .service-bar-wrap { padding: 12px 16px; }
      .overlay-card { padding: 28px 20px; }
      .service-time { font-size: 24px; }
      .name-input-group .input-row { flex-direction: column; }
      .name-input-group .input-row button { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

<!-- ============================================================
     HEADER
     ============================================================ -->
<header>
  <div class="brand">
    <span class="chef-badge" id="chefIconSlot"></span>
    <h1>Overcooked</h1>
    <span class="sub">Ticket Rail</span>
  </div>
  <div class="header-controls">
    <span class="status-pill idle" id="controllerStatus"></span>
  </div>
</header>

<!-- ============================================================
     SERVICE BAR
     ============================================================ -->
<div class="service-bar-wrap">
  <div class="service-row">
    <span id="serviceLabelSlot"></span>
    <span class="service-time" id="serviceTime">05:00</span>
  </div>
  <div class="service-track"><div class="service-fill" id="serviceFill"></div></div>
</div>

<!-- ============================================================
     STATS
     ============================================================ -->
<div class="stat-strip">
  <div class="stat"><span class="num gold" id="statScore"></span><span class="label">Score</span></div>
  <div class="stat"><span class="num green" id="statServed"></span><span class="label">Served</span></div>
  <div class="stat"><span class="num red" id="statMissed"></span><span class="label">Missed</span></div>
  <div class="stat"><span class="num red" id="statFailed"></span><span class="label">Failed</span></div>
</div>

<!-- ============================================================
     RAIL
     ============================================================ -->
<div class="rail-wrap">
  <div class="rail-bar"></div>
  <div class="rail" id="rail">
    <div class="empty-rail loading" id="emptyMsg">
      <div class="glyph"></div>
      <div class="title">Loading recipes...</div>
      <div class="sub">Getting the kitchen ready.</div>
    </div>
  </div>
</div>

<!-- ============================================================
     STATUS MESSAGE
     ============================================================ -->
<div class="status-msg" id="statusMsg"></div>

<!-- ============================================================
     TOAST
     ============================================================ -->
<div class="toast" id="toast"></div>

<!-- ============================================================
     OVERLAY - LEADERBOARD LINK REMOVED
     ============================================================ -->
<div class="overlay" id="overlay">
  <div class="overlay-card">
    <span class="plate-badge" id="plateBadgeSlot"></span>
    <h2>Service Complete</h2>
    <div class="stars" id="overlayStars"></div>
    
    <div class="overlay-stats">
      <div>Final Score <b id="ovScore">0</b></div>
      <div>Orders Served <b id="ovServed">0</b></div>
      <div>Orders Missed <b id="ovMissed">0</b></div>
      <div>Orders Failed <b id="ovFailed">0</b></div>
    </div>

    <!-- Name Input -->
    <div class="name-input-group">
      <label for="playerName">🏆 Enter Your Name</label>
      <div class="input-row">
        <input 
          type="text" 
          id="playerName" 
          placeholder="Your name..." 
          maxlength="20"
          autocomplete="off"
        >
        <button class="chef-btn" id="submitScoreBtn">📤 Save Score</button>
      </div>
      <div class="hint">⭐ Your score will be saved to the leaderboard</div>
    </div>

    <button class="chef-btn start" id="playAgainBtn" style="width:100%; padding:14px; font-size:15px; border-radius:30px; justify-content:center;"></button>
  </div>
</div>

<!-- ============================================================
     FRONTEND JAVASCRIPT
     ============================================================ -->
<script src="/game.js"></script>

</body>
</html>