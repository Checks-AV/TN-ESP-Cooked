<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/main.css">

    <script>
        const methods              = <%- JSON.stringify(methods) %>;
        window.ingredientsList     = <%- JSON.stringify(ingredients) %>;
        window.statusesList        = <%- JSON.stringify(statuses) %>;
    </script>
</head>
<body>

    <h1>Add New Recipe</h1>
    <a href="/settings/recipe">← Back to Recipes</a>

    <br><br>

    <form action="/settings/recipe/addrecipe" method="POST">

        <!-- ─── FOOD NAME ──────────────────────────────────── -->
        <div>
            <label>Food Name:</label>
            <input
                type="text"
                name="food_name"
                placeholder="e.g. Chicken Sandwich"
                required
            >
        </div>

        <br>

        <!-- ─── INGREDIENT BLOCKS ─────────────────────────── -->
        <div id="ingredients-container">

            <!-- First ingredient: static at index 0, no remove button -->
            <div class="ingredient-block" id="ingredient-block-0">

                <hr>
                <h2>Ingredient 1</h2>

                <div>
                    <label>Ingredient:</label>
                    <select name="ingredients[0][ingredients_id]" required>
                        <option value="">-- Select --</option>
                        <% ingredients.forEach(i => { %>
                            <option value="<%= i.ingredients_id %>">
                                <%= i.ingredients_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <br>

                <div>
                    <label>Final Status:</label>
                    <select name="ingredients[0][ingredientstatus_id]" required>
                        <option value="">-- Select --</option>
                        <% statuses.forEach(s => { %>
                            <option value="<%= s.ingredientstatus_id %>">
                                <%= s.ingredientstatus_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <br>

                <div>
                    <label>Required Amount:</label>
                    <input
                        type="number"
                        name="ingredients[0][required_amount]"
                        min="1"
                        value="1"
                        required
                    >
                </div>

                <br>

                <div id="steps-0">
                    <h3>Preparation Steps</h3>
                </div>

                <button
                    type="button"
                    onclick="addStep(0)"
                >
                    + Add Step
                </button>

            </div>
            <!-- end ingredient-block-0 -->

        </div>
        <!-- end #ingredients-container -->

        <br>

        <button
            type="button"
            onclick="addIngredient()"
        >
            + Add Another Ingredient
        </button>

        <br><br>
        <hr>

        <button type="submit">
            Save Recipe
        </button>

    </form>

    <script src="/scripts/addrecipe.js"></script>

</body>
</html>