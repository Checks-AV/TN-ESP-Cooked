<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <script>
    const methods = <%- JSON.stringify(methods) %>;
    </script>
    <script src="/scripts/addrecipe.js"></script>
</head>
<body>
    <h1>Recipe Management</h1>
    
    <form action="/settings/recipe/addrecipe" method="POST">

    <div>
        <label>Food Name:</label>
        <input type="text" name="food_name" required>
    </div>

    <hr>

    <!-- INGREDIENT 1 -->
    <h2>Ingredient 1</h2>

    <div>
        <label>Ingredient:</label>
        <select name="ingredients[0][ingredients_id]" required>
            <% ingredients.forEach(ingredient => { %>
                <option value="<%= ingredient.ingredients_id %>">
                    <%= ingredient.ingredients_name %>
                </option>
            <% }) %>
        </select>
    </div>

    <!--<div>
        <label>Final Status:</label>
        <select name="ingredients[0][ingredientstatus_id]" required>
            <% statuses.forEach(status => { %>
                <option value="<%= status.ingredientstatus_id %>">
                    <%= status.ingredientstatus_name %>
                </option>
            <% }) %>
        </select>
    </div>
    -->
    <div>
        <label>Required Amount:</label>
        <input
            type="number"
            name="ingredients[0][required_amount]"
            min="1"
            value="1"
            required
        >
    </div>

    <!-- DYNAMIC STEPS CONTAINER -->
    <div id="steps-0">
        <h3>Preparation Steps</h3>
    </div>

    <button type="button" onclick="addStep(0)">
        Add Step
    </button>

    <hr>

    <!-- INGREDIENT 2 -->
    <h2>Ingredient 2</h2>

    <div>
        <label>Ingredient:</label>
        <select name="ingredients[1][ingredients_id]">
            <option value="">-- None --</option>

            <% ingredients.forEach(ingredient => { %>
                <option value="<%= ingredient.ingredients_id %>">
                    <%= ingredient.ingredients_name %>
                </option>
            <% }) %>
        </select>
    </div>

    <!--<div>
        <label>Final Status:</label>
        <select name="ingredients[0][ingredientstatus_id]" required>
            <% statuses.forEach(status => { %>
                <option value="<%= status.ingredientstatus_id %>">
                    <%= status.ingredientstatus_name %>
                </option>
            <% }) %>
        </select>
    </div>
    -->

    <div>
        <label>Required Amount:</label>
        <input
            type="number"
            name="ingredients[1][required_amount]"
            min="1"
            value="1"
        >
    </div>

    <!-- DYNAMIC STEPS CONTAINER -->
    <div id="steps-1">
        <h3>Preparation Steps</h3>
    </div>

    <button type="button" onclick="addStep(1)">
        Add Step
    </button>

    <br><br>

    <button type="submit">
        Save Recipe
    </button>
</form>


</body>
</html>