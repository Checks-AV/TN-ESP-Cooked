<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enitio 2026 — Credits</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --espresso: #1b1613;
    --espresso-2: #241d18;
    --parchment: #f1e6cf;
    --parchment-dim: #cdbf9e;
    --gold: #b8923f;
    --gold-light: #d9b56a;
    --rust: #8a3c2b;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    min-height:100vh;
    background:
      radial-gradient(ellipse at 50% -10%, rgba(184,146,63,0.10), transparent 55%),
      var(--espresso);
    color:var(--parchment);
    font-family:'Cormorant Garamond', serif;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:56px 20px;
  }
  body::before{
    content:'';
    position:fixed; inset:0;
    background-image: radial-gradient(rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size:3px 3px;
    pointer-events:none;
    mix-blend-mode:overlay;
  }

  .card{
    position:relative;
    width:100%;
    max-width:620px;
    padding:64px 56px 52px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.015), transparent 20%),
      var(--espresso-2);
    box-shadow: 0 30px 80px rgba(0,0,0,0.55);
  }
  .card::before{
    content:'';
    position:absolute; inset:14px;
    border:1px solid rgba(184,146,63,0.55);
    pointer-events:none;
  }
  .card::after{
    content:'';
    position:absolute; inset:19px;
    border:1px solid rgba(184,146,63,0.22);
    pointer-events:none;
  }

  .seal{
    width:52px; height:52px;
    margin:0 auto 22px;
    border-radius:50%;
    border:1.5px solid var(--gold);
    display:flex; align-items:center; justify-content:center;
    position:relative;
    z-index:1;
  }
  .seal::before{
    content:'';
    position:absolute; inset:5px;
    border:1px solid rgba(184,146,63,0.5);
    border-radius:50%;
  }
  .seal span{
    font-family:'Cinzel', serif;
    font-size:19px;
    font-weight:600;
    color:var(--gold-light);
    letter-spacing:1px;
  }

  .eyebrow{
    text-align:center;
    font-family:'Inter', sans-serif;
    font-size:10.5px;
    font-weight:600;
    letter-spacing:4px;
    text-transform:uppercase;
    color:var(--parchment-dim);
    margin:0 0 18px;
    position:relative;
    z-index:1;
  }

  h1{
    text-align:center;
    font-family:'Cinzel', serif;
    font-weight:600;
    font-size:clamp(40px, 7vw, 54px);
    letter-spacing:6px;
    margin:0;
    color:var(--parchment);
    text-shadow:0 1px 0 rgba(0,0,0,0.4);
    position:relative;
    z-index:1;
  }

  .year{
    text-align:center;
    font-family:'Cinzel', serif;
    font-size:15px;
    letter-spacing:8px;
    color:var(--gold);
    margin:6px 0 0;
    position:relative;
    z-index:1;
  }

  .rule-orn{
    display:flex; align-items:center; gap:14px;
    margin:26px 0 22px;
    position:relative; z-index:1;
  }
  .rule-orn .line{ flex:1; height:1px; background:linear-gradient(90deg, transparent, var(--gold) 50%, transparent); }
  .rule-orn svg{ width:14px; height:14px; flex-shrink:0; }

  .elaboration{
    text-align:center;
    font-style:italic;
    font-weight:500;
    font-size:20px;
    letter-spacing:1.5px;
    color:var(--parchment-dim);
    margin:0 0 6px;
    position:relative; z-index:1;
  }
  .elaboration-sub{
    text-align:center;
    font-family:'Inter', sans-serif;
    font-size:10px;
    letter-spacing:3.5px;
    text-transform:uppercase;
    color:var(--gold);
    margin:0 0 40px;
    position:relative; z-index:1;
  }

  .course{
    position:relative; z-index:1;
    margin-bottom:34px;
  }
  .course:last-of-type{ margin-bottom:0; }

  .course-title{
    text-align:center;
    font-family:'Cinzel', serif;
    font-size:13px;
    font-weight:600;
    letter-spacing:5px;
    text-transform:uppercase;
    color:var(--gold-light);
    margin:0 0 4px;
  }
  .course-desc{
    text-align:center;
    font-family:'Inter', sans-serif;
    font-style:normal;
    font-size:10.5px;
    letter-spacing:1.5px;
    color:var(--parchment-dim);
    text-transform:uppercase;
    opacity:0.6;
    margin:0 0 22px;
  }

  .entry{
    display:flex;
    align-items:baseline;
    gap:10px;
    padding:10px 0;
  }
  .entry + .entry{
    border-top:1px solid rgba(184,146,63,0.16);
  }
  .entry .name{
    flex:0 0 auto;
    font-size:21px;
    font-weight:500;
    letter-spacing:0.5px;
    color:var(--parchment);
    white-space:nowrap;
  }
  .entry .leader{
    flex:1 1 auto;
    border-bottom:1px dotted rgba(205,191,158,0.35);
    margin-bottom:6px;
    min-width:20px;
  }
  .entry .role{
    flex:0 0 auto;
    font-family:'Inter', sans-serif;
    font-size:10.5px;
    font-weight:500;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:var(--gold);
    white-space:nowrap;
    text-align:right;
  }

  .footer-rule{
    margin:44px 0 20px;
    height:1px;
    background:linear-gradient(90deg, transparent, rgba(184,146,63,0.5) 50%, transparent);
    position:relative; z-index:1;
  }
  .footer-note{
    text-align:center;
    font-style:italic;
    font-size:14px;
    color:var(--parchment-dim);
    letter-spacing:0.5px;
    position:relative; z-index:1;
    margin:0;
  }

  @media (max-width:520px){
    .card{ padding:48px 26px 40px; }
    .entry{ flex-wrap:wrap; }
    .entry .name{ font-size:18px; }
    .entry .leader{ display:none; }
    .entry .role{ flex:1 1 100%; text-align:left; margin-top:2px; }
    h1{ letter-spacing:3px; }
  }
</style>
</head>
<body>

<div class="card">

  <div class="seal"><span>E</span></div>
  <div class="eyebrow">Presented by the Brigade</div>

  <h1>Enitio</h1>
  <div class="year">2026</div>

  <div class="rule-orn">
    <span class="line"></span>
    <svg viewBox="0 0 24 24" fill="none" stroke="#b8923f" stroke-width="1.4"><path d="M12 3l2.4 6.6L21 12l-6.6 2.4L12 21l-2.4-6.6L3 12l6.6-2.4L12 3z"/></svg>
    <span class="line"></span>
  </div>

  <p class="elaboration">Overcooked</p>
  <p class="elaboration-sub">A Ticket Rail Production</p>

  <div class="course">
    <div class="course-title">Software</div>
    <div class="course-desc">The Recipe &amp; The Rail</div>
    <div class="entry">
      <span class="name">Tian&nbsp;Ning</span>
      <span class="leader"></span>
      <span class="role">Lead Software Developer</span>
    </div>
    <div class="entry">
      <span class="name">Avan</span>
      <span class="leader"></span>
      <span class="role">Software Developer</span>
    </div>
  </div>

  <div class="course">
    <div class="course-title">Hardware</div>
    <div class="course-desc">The Pass &amp; The Counter</div>
    <div class="entry">
      <span class="name">En&nbsp;Hui</span>
      <span class="leader"></span>
      <span class="role">Lead Hardware Engineer</span>
    </div>
    <div class="entry">
      <span class="name">Yong&nbsp;Ying</span>
      <span class="leader"></span>
      <span class="role">Hardware Engineer</span>
    </div>
  </div>

  <div class="footer-rule"></div>
  <p class="footer-note">Service concluded — thank you for playing.</p>

</div>

</body>
</html>