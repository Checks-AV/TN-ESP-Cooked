<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title><%= title%></title>
</head>
<body>
  <header>
    <!-- Requirement: Main Page, Redirects to Settings AND Start of Game-->
    <h1>Welcome Avan, Redirect to Stage Setting here</h1>
    
    <!-- Requirement: Redirect to <<Order Slips Page>> Section-->
    <button type="button" onclick="window.location.href='/game'">Go to Game</button> <br>
    
    <!-- NEW: Game Settings Button -->
    <button type="button" onclick="window.location.href='/game/settings'" style="background: #FF9800; color: white;">Game Settings</button> <br>
    
    <!-- Requirement: Redirect to <<Setup Page>> Section-->
    <button type="button" onclick="window.location.href='/settings'">Settings</button> <br>
    
    <!-- NEW: ESP Dashboard Button -->
    <button type="button" onclick="window.location.href='/espdashboard'" style="background: #4CAF50; color: white;">ESP Dashboard</button> <br>
    
    <!-- Requirement: Redirect to <<Leaderboards Page>> Section-->
    <button type="button" onclick="window.location.href='/leaderboards'">Leaderboards</button> <br>
    
    <!-- Requirement: Redirect to <<Credits Page>> Section-->
    <button type="button" onclick="window.location.href='/credits'">Credits</button> <br>
  </header>
</body>
</html>