<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title><%= title%></title>
    <style>
        /* Light Background & Base Styles */
        body {
            background: #f5f0eb !important;
            min-height: 100vh !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 20px !important;
            margin: 0 !important;
        }
        
        header {
            max-width: 600px !important;
            margin: 0 auto !important;
            padding: 40px !important;
            background: #ffffff !important;
            border-radius: 20px !important;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08) !important;
            border: 1px solid rgba(0,0,0,0.04) !important;
        }
        
        h1 {
            font-size: 42px !important;
            color: #1a1a1a !important;
            text-align: center !important;
            margin-bottom: 8px !important;
            font-weight: 800 !important;
        }
        
        .subtitle {
            text-align: center !important;
            color: #6b6558 !important;
            font-size: 16px !important;
            margin-bottom: 30px !important;
        }
        
        p {
            font-size: 18px !important;
            color: #4a4a4a !important;
        }
        
        button {
            font-size: 20px !important;
            padding: 16px 24px !important;
            width: 100% !important;
            border-radius: 12px !important;
            border: 2px solid transparent !important;
            cursor: pointer !important;
            transition: 0.15s !important;
            font-weight: 600 !important;
        }
        button:hover {
            transform: scale(1.02);
            opacity: 0.9;
        }
        button:active {
            transform: scale(0.98);
        }
        
        /* Option A: Modern Tech Colors */
        .btn-game {
            background: #10b981 !important;
            color: #fff !important;
            border-color: #059669 !important;
        }
        .btn-settings {
            background: #f59e0b !important;
            color: #1a1a1a !important;
            border-color: #d97706 !important;
        }
        .btn-monitor {
            background: #8b5cf6 !important;
            color: #fff !important;
            border-color: #7c3aed !important;
        }
        .btn-setup {
            background: #3b82f6 !important;
            color: #fff !important;
            border-color: #2563eb !important;
        }
        .btn-test {
            background: #06b6d4 !important;
            color: #fff !important;
            border-color: #0891b2 !important;
        }
        .btn-extra {
            background: #64748b !important;
            color: #fff !important;
            border-color: #475569 !important;
        }
        .btn-leaderboard {
            background: #fbbf24 !important;
            color: #1a1a1a !important;
            border-color: #f59e0b !important;
        }
        .btn-credits {
            background: #d4a373 !important;
            color: #1a1a1a !important;
            border-color: #c4905e !important;
        }
        /* NEW: Log Viewer button — warm teal / sea-green, friendly & distinct */
        .btn-logviewer {
            background: #2a9d8f !important;    /* deep teal */
            color: #ffffff !important;
            border-color: #21867a !important;
        }
        
        .label-text {
            color: #6b6558 !important;
            font-size: 18px !important;
            margin-bottom: 6px !important;
            margin-top: 16px !important;
            font-weight: 600 !important;
            letter-spacing: 0.5px !important;
        }
        
        .label-text:first-of-type {
            margin-top: 0 !important;
        }
    </style>
</head>
<body>
  <header>
    <!-- Main Title -->
    <h1>Welcome To Overcooked</h1>
    <p class="subtitle">Ticket Rail Control Center</p>
    
    <!-- For participants to see -->
    <p class="label-text">For participants to see</p>
    <button class="btn-game" onclick="window.location.href='/game'">Game</button> <br>
    
    <!-- For Control -->
    <p class="label-text">For Control</p>
    <button class="btn-settings" onclick="window.location.href='/game/settings'">Game Settings</button> <br>
    
    <!-- For Monitor -->
    <p class="label-text">For Monitor</p>
    <button class="btn-monitor" onclick="window.location.href='/esp-monitor.html'">ESP32 Monitor</button> <br>
    
    <!-- NEW: For Checking (inserted right after Monitor, before Setup) -->
    <p class="label-text">For Checking</p>
    <button class="btn-logviewer" onclick="window.location.href='/logviewer'">Log Viewer</button> <br>
    
    <!-- For Setup -->
    <p class="label-text">For Setup</p>
    <button class="btn-setup" onclick="window.location.href='/settings'">Settings</button> <br>
    
    <!-- For Testing -->
    <p class="label-text">For Testing</p>
    <button class="btn-test" onclick="window.location.href='/esp-test-console.html'">Test Console</button> <br>
    
    <!-- Extra -->
    <p class="label-text">Extra</p>
    <button class="btn-extra" onclick="window.location.href='/how-it-works.html'">How Ticket Rail Works</button> <br>
    
    <!-- Score / Leaderboards / Credits -->
    <p class="label-text">Score</p>
    <button class="btn-leaderboard" onclick="window.location.href='/leaderboards'">Leaderboards</button> <br>
    
    <p class="label-text">All the hard work by</p>
    <button class="btn-credits" onclick="window.location.href='/credits'">Credits</button> <br>
  </header>
</body>
</html>